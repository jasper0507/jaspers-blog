{
  "name": "jaspers-blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "BLOG_CONTENT_DIR=tests/fixtures/content astro dev",
    "preview": "astro preview",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.{astro,js,ts}\" \"src/styles/{global,markdown-body,shuoshuo-card,search}.css\" \"scripts/**/*.mjs\" \"packages/**/*.{js,json,md}\" \"tests/site/**/*.ts\" \"playwright*.config.ts\" \"*.{json,mjs,ts}\" \"docs/**/*.md\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.{astro,js,ts}\" \"src/styles/{global,markdown-body,shuoshuo-card,search}.css\" \"scripts/**/*.mjs\" \"packages/**/*.{js,json,md}\" \"tests/site/**/*.ts\" \"playwright*.config.ts\" \".github/workflows/*.{yml,yaml}\" \"*.{json,mjs,ts}\" \"docs/**/*.md\"",
    "check": "BLOG_CONTENT_DIR=tests/fixtures/content JASPER_ACCEPTANCE_CACHE=node_modules/.astro-check astro check",
    "build": "BLOG_CONTENT_DIR=tests/fixtures/content npm run build:content",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "test:config": "node src/lib/hero-images.ts && node scripts/check-site.mjs",
    "test:fonts": "node scripts/check-fonts.mjs && node --test scripts/check-fetch-fonts.mjs",
    "test:content-rules": "node scripts/check-post-stable-ids.mjs && node --test tests/site/posts.test.ts",
    "test:index-posts": "node scripts/check-index-posts.mjs",
    "test:markdown": "node --test tests/site/markdown.test.ts",
    "test:site": "playwright test",
    "test:guard": "node --test tests/site/guard.test.ts tests/site/acceptance.test.ts tests/site/content-tools.test.ts tests/site/publish-cli.test.ts tests/site/publish-site.test.ts tests/site/content-release.test.ts",
    "test:browser-smoke": "playwright test --config=playwright.smoke.config.ts",
    "test": "npm run format:check && npm run check && npm run test:fonts && npm run test:config && npm run test:content-rules && npm run test:index-posts && npm run test:markdown && npm run test:site && npm run test:guard",
    "build:content": "node scripts/check-site-markdown.mjs && astro build --force && node scripts/index-posts.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.3.5",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@shikijs/transformers": "4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "github-slugger": "2.0.0",
    "katex": "0.18.1",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "satteri": "0.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
