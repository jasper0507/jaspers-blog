{
  "name": "jaspers-blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,js,ts}\" \"src/styles/{global,markdown-body,shuoshuo-card}.css\" \"scripts/**/*.mjs\" \"tests/site/**/*.ts\" \"playwright.config.ts\" \"*.{json,mjs}\" \"docs/**/*.md\" \"THIRD_PARTY_NOTICES.md\"",
    "format:check": "prettier --check \"src/**/*.{astro,js,ts}\" \"src/styles/{global,markdown-body,shuoshuo-card}.css\" \"scripts/**/*.mjs\" \"tests/site/**/*.ts\" \"playwright.config.ts\" \"*.{json,mjs}\" \"docs/**/*.md\" \"THIRD_PARTY_NOTICES.md\"",
    "check": "astro check",
    "build": "astro build --force && pagefind --site dist --glob \"posts/**/*.html\"",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "new:post": "node scripts/new-post.mjs",
    "new:shuoshuo": "node scripts/new-shuoshuo.mjs",
    "publish": "node scripts/publish.mjs",
    "test:post:command": "node scripts/check-new-post.mjs",
    "test:publish:command": "node scripts/check-publish.mjs",
    "test:repo-sync:command": "node scripts/check-repo-sync.mjs",
    "test:shuoshuo:command": "node scripts/check-new-shuoshuo.mjs",
    "test:site": "playwright test",
    "test": "npm run format:check && npm run check && node scripts/check-fetch-fonts.mjs && npm run test:post:command && npm run test:shuoshuo:command && npm run test:repo-sync:command && npm run test:publish:command && npm run test:site"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.3.5",
    "@playwright/test": "^1.61.1",
    "@shikijs/transformers": "4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "github-slugger": "2.0.0",
    "katex": "0.18.1",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/styles/global.css"
  }
}
