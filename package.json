{
  "name": "jaspers-blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,js,ts}\" \"src/styles/{global,markdown-body,shuoshuo-card}.css\" \"scripts/**/*.mjs\" \"*.{json,mjs}\" \"docs/**/*.md\" \"THIRD_PARTY_NOTICES.md\"",
    "format:check": "prettier --check \"src/**/*.{astro,js,ts}\" \"src/styles/{global,markdown-body,shuoshuo-card}.css\" \"scripts/**/*.mjs\" \"*.{json,mjs}\" \"docs/**/*.md\" \"THIRD_PARTY_NOTICES.md\"",
    "check": "astro check",
    "build": "astro build && pagefind --site dist --glob \"posts/**/*.html\"",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "new:post": "node scripts/new-post.mjs",
    "new:shuoshuo": "node scripts/new-shuoshuo.mjs",
    "test:settings": "node --experimental-strip-types scripts/check-blog-settings.mjs",
    "test:post:command": "node scripts/check-new-post.mjs",
    "test:shuoshuo:command": "node scripts/check-new-shuoshuo.mjs",
    "test:site": "node --experimental-strip-types scripts/check-site.mjs",
    "test": "npm run format:check && npm run check && npm run test:settings && node scripts/check-fetch-fonts.mjs && npm run test:post:command && npm run test:shuoshuo:command && npm run test:site"
  },
  "dependencies": {
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@shikijs/transformers": "4.3.1",
    "github-slugger": "2.0.0",
    "katex": "0.18.1",
    "pagefind": "1.5.2",
    "playwright-core": "1.61.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "rehype-katex": "7.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-math": "6.0.0",
    "typescript": "6.0.3"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
