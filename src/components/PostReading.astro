---
import type { MarkdownHeading } from "astro";
import BackToTop from "./BackToTop.astro";
import MarkdownBody from "./MarkdownBody.astro";
import PostTags from "./PostTags.astro";
import PostToc from "./PostToc.astro";
import type { PublishedPost } from "../lib/posts";

interface Props {
  post: PublishedPost;
  headings: MarkdownHeading[];
  older?: PublishedPost;
  newer?: PublishedPost;
}

const { post, headings, older, newer } = Astro.props;
---

<div class="post-reading" data-post-reading>
  <article class="post-article" aria-labelledby="post-title" data-pagefind-body>
    <header class="post-header">
      <h1 id="post-title" tabindex="-1">{post.title}</h1>
      {post.description ? <p class="post-description">{post.description}</p> : null}
      <div class="post-meta">
        <time datetime={post.publishedAt.iso}>{post.publishedAt.compact}</time>
        <PostTags tags={post.tags} />
      </div>
      <PostToc headings={headings} inline />
    </header>

    <MarkdownBody>
      <slot />
    </MarkdownBody>
  </article>

  {
    (older || newer) && (
      <nav class="post-pager" aria-label="相邻文章">
        {older && (
          <a class="post-pager-link" href={older.href} rel="prev">
            <span class="post-pager-meta">
              上一篇 · <time datetime={older.publishedAt.iso}>{older.publishedAt.compact}</time>
            </span>
            <span class="post-pager-title">{older.title}</span>
          </a>
        )}
        {newer && (
          <a class="post-pager-link post-pager-next" href={newer.href} rel="next">
            <span class="post-pager-meta">
              下一篇 · <time datetime={newer.publishedAt.iso}>{newer.publishedAt.compact}</time>
            </span>
            <span class="post-pager-title">{newer.title}</span>
          </a>
        )}
      </nav>
    )
  }

  <PostToc headings={headings} />
  <BackToTop />
</div>

<script is:inline>
  (() => {
    const reading = document.querySelector("[data-post-reading]");
    if (!(reading instanceof HTMLElement)) return;

    const reduceMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
    const button = reading.querySelector("#back-to-top");
    const header = reading.querySelector(".post-header");
    const title = reading.querySelector("#post-title");

    if (button instanceof HTMLButtonElement && header instanceof HTMLElement) {
      const setVisible = visible => {
        button.dataset.visible = visible ? "true" : "false";
        button.toggleAttribute("inert", !visible);
        if (!visible && document.activeElement === button && title instanceof HTMLElement) {
          title.focus();
        }
      };

      button.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: reduceMotion() ? "auto" : "smooth" });
      });

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(([entry]) => setVisible(!entry.isIntersecting));
        observer.observe(header);
      }
    }

    const tocNav = reading.querySelector(".post-toc");
    if (!(tocNav instanceof HTMLElement)) return;

    const items = [...tocNav.querySelectorAll("a[data-heading-id]")].map(link => {
      const id = link.getAttribute("data-heading-id") ?? "";
      const heading = document.getElementById(id);
      if (!heading) throw new Error("文章目录目标不存在：" + id);
      return { link, heading };
    });

    let activeId = "";
    const setActive = id => {
      if (!id || id === activeId) return;
      activeId = id;
      for (const { link, heading } of items) {
        if (heading.id === id) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };

    setActive(items[0].heading.id);

    if (!("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      () => {
        const current =
          items.findLast(
            ({ heading }) => heading.getBoundingClientRect().top <= window.innerHeight * 0.45,
          ) ?? items[0];
        setActive(current.heading.id);
      },
      {
        rootMargin: "0px 0px -55% 0px",
        threshold: [0, 0.25, 1],
      },
    );

    for (const { heading } of items) observer.observe(heading);
  })();
</script>

<style>
  .post-reading {
    --reading-width: 47.5rem;
  }

  /* 编辑长文壳：居中阅读栏，无纸面卡片 */
  .post-article {
    max-width: var(--reading-width);
    margin-inline: auto;
    min-width: 0;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .post-header h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: var(--track-display);
    line-height: var(--leading-display);
    font-optical-sizing: auto;
  }

  .post-description {
    max-width: 40rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  /* 时间正序：上一篇更早、居左，下一篇更新、居右。 */
  .post-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    max-width: var(--reading-width);
    margin: 4.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-sans);
  }

  .post-pager-link {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
    text-decoration: none;
  }

  .post-pager-next {
    grid-column: 2;
    text-align: right;
  }

  .post-pager-meta {
    color: var(--muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  .post-pager-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition: color var(--duration) var(--ease-out);
  }

  .post-pager-link:hover .post-pager-title {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .post-pager {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 3.5rem;
    }

    .post-pager-next {
      grid-column: auto;
      text-align: left;
    }
  }

  @media (max-width: 52rem) {
    .post-header {
      margin-bottom: 2.25rem;
      padding-bottom: 1.35rem;
    }

    .post-header h1 {
      font-size: 1.8rem;
      line-height: 1.25;
    }

    .post-meta {
      margin-top: 1.25rem;
    }
  }
</style>

<style is:global>
  .post-meta .post-tags {
    justify-content: flex-end;
    margin-inline-start: auto;
  }
</style>
