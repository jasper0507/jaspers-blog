---
import { getTagSlug } from "../lib/tags";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="post-tags" aria-label="标签">
      {tags.map(tag => (
        <li>
          <a href={`/tags/${getTagSlug(tag)}/`}>
            <span class="tag-hash" aria-hidden="true">
              #
            </span>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
