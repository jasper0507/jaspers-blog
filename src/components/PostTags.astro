---
import type { PublishedTag } from "../lib/posts";

interface Props {
  tags: PublishedTag[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="post-tags" aria-label="标签">
      {tags.map(({ href, name }) => (
        <li>
          <a href={href}>
            <span class="tag-hash" aria-hidden="true">
              #
            </span>
            {name}
          </a>
        </li>
      ))}
    </ul>
  )
}
