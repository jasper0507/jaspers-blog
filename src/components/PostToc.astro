---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const toc = Astro.props.headings.filter(
  ({ depth, slug }) => (depth === 2 || depth === 3) && slug !== "footnote-label",
);

if (toc.length === 0) return;
---

<nav class="post-toc" aria-label="文章目录">
  <p>目录</p>
  <ol>
    {
      toc.map(heading => (
        <li class:list={[`toc-depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`} data-heading-id={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .post-toc {
    display: none;
    width: 11.25rem;
    max-height: 60vh;
    padding-left: 1.125rem;
    position: fixed;
    z-index: var(--z-toc);
    top: 50%;
    left: calc(50% + var(--reading-width) / 2 + 2.5rem);
    overflow-x: hidden;
    overflow-y: auto;
    border-left: 1px solid var(--line);
    transform: translateY(-50%);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--line) 38%, transparent) transparent;
  }

  .post-toc::-webkit-scrollbar {
    width: 5px;
  }

  .post-toc::-webkit-scrollbar-track,
  .post-toc::-webkit-scrollbar-corner {
    background: transparent;
  }

  .post-toc::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--line) 38%, transparent);
    border-radius: 999px;
  }

  .post-toc > p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .post-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-toc li {
    margin-bottom: 0.2rem;
    line-height: 1.45;
  }

  .post-toc .toc-depth-3 {
    padding-left: 0.65rem;
  }

  .post-toc a {
    display: block;
    margin-left: -0.65rem;
    padding: 0.32rem 0.4rem 0.32rem 0.6rem;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-decoration: none;
    transition:
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .post-toc a:hover {
    color: var(--accent);
  }

  .post-toc a[aria-current="true"] {
    border-left-color: var(--accent);
    color: var(--accent);
    font-weight: 500;
  }

  @media (min-width: 80rem) {
    .post-toc {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-toc a {
      transition: none;
    }
  }
</style>
