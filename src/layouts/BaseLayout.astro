---
import "../styles/fonts.css";
import "../styles/global.css";
import { blogSettings } from "../lib/site";

interface PageData {
  title?: string;
  description?: string;
  pageClass?: string;
  ogType?: "website" | "article";
}

interface Props extends PageData {
  frontmatter?: PageData;
}

const {
  title: siteTitle,
  headerTitle,
  description: defaultDescription,
  url,
  favicon,
} = blogSettings.site;
const { github, email } = blogSettings.author;
const footerCopyright = blogSettings.footer.copyright;
const pageData = Astro.props.frontmatter ?? Astro.props;
const title = pageData.title ? `${pageData.title} | ${siteTitle}` : siteTitle;
const description = pageData.description ?? defaultDescription;
const canonical = new URL(Astro.url.pathname, url);
const path = Astro.url.pathname;
const inArticles = ["/posts/", "/tags/", "/archives/"].some(prefix => path.startsWith(prefix));
const structuredData = JSON.stringify(
  path === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteTitle,
        url: canonical.href,
        inLanguage: "zh-CN",
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: pageData.title ?? siteTitle,
        description,
        url: canonical.href,
        inLanguage: "zh-CN",
      },
).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {favicon && <link rel="icon" href={favicon} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={pageData.ogType ?? "website"} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <title>{title}</title>
    <slot name="head">
      <script type="application/ld+json" set:html={structuredData} is:inline />
    </slot>
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
    <script is:inline>
      (() => {
        const key = "jasper-theme";
        const root = document.documentElement;

        try {
          const saved = localStorage.getItem(key);
          if (saved === "light" || saved === "dark") root.dataset.theme = saved;
        } catch (error) {
          console.warn("无法读取主题设置，将跟随系统主题。", error);
        }

        document.addEventListener("DOMContentLoaded", () => {
          const button = document.querySelector("#theme-toggle");
          if (!(button instanceof HTMLButtonElement)) return;

          const currentTheme = () =>
            root.dataset.theme ??
            (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

          const updateButton = () => {
            const current = currentTheme();
            const label = current === "dark" ? "切换至亮色主题" : "切换至暗色主题";
            button.dataset.theme = current;
            button.setAttribute("aria-label", label);
            button.title = label;
          };

          button.addEventListener("click", () => {
            const next = currentTheme() === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            try {
              localStorage.setItem(key, next);
            } catch (error) {
              console.warn("无法保存主题设置。", error);
            }
            updateButton();
          });

          matchMedia("(prefers-color-scheme: dark)").addEventListener("change", updateButton);
          updateButton();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={`${headerTitle} 首页`}>{headerTitle}</a>
        <nav aria-label="主导航">
          <ul class="nav-list">
            <li>
              <div class="article-menu" id="article-menu">
                <button
                  id="article-menu-trigger"
                  type="button"
                  popovertarget="article-menu-list"
                  data-active={inArticles || undefined}
                >
                  文章
                  <svg viewBox="0 0 12 12" aria-hidden="true">
                    <path d="m2.5 4 3.5 3.5L9.5 4"></path>
                  </svg>
                </button>
                <ul class="article-menu-list" id="article-menu-list" popover>
                  <li>
                    <a
                      href="/archives/"
                      aria-current={path.startsWith("/archives/") ? "page" : undefined}
                    >
                      归档
                    </a>
                  </li>
                  <li>
                    <a href="/tags/" aria-current={path.startsWith("/tags/") ? "page" : undefined}>
                      标签
                    </a>
                  </li>
                </ul>
              </div>
            </li>
            <li>
              <a
                href="/shuoshuo/"
                aria-current={path.startsWith("/shuoshuo/") ? "page" : undefined}
              >
                说说
              </a>
            </li>
            <li>
              <a href="/about/" aria-current={path.startsWith("/about/") ? "page" : undefined}>
                关于
              </a>
            </li>
            <li class="nav-search">
              {/* 放大镜入口；/ 打开面板（可编辑焦点下不劫持）；Esc/遮罩/关闭钮退出 */}
              <pagefind-modal-trigger compact hide-shortcut shortcut="/" placeholder="搜索"
              ></pagefind-modal-trigger>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class={pageData.pageClass}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-content">{footerCopyright}</div>
        <ul aria-label="联系方式">
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href={github}>GitHub</a></li>
          <li>
            <a href={`mailto:${email}`}>邮箱</a>
          </li>
        </ul>
      </div>
    </footer>
    {/* ponytail: 当前索引很小；内容规模明显增长时再恢复 Worker。 */}
    <pagefind-config no-worker lang="zh-cn"></pagefind-config>
    <pagefind-modal reset-on-close>
      <pagefind-modal-header>
        <pagefind-input placeholder="搜索技术文章"></pagefind-input>
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary></pagefind-summary>
        <pagefind-results hide-sub-results></pagefind-results>
      </pagefind-modal-body>
      <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
      </pagefind-modal-footer>
    </pagefind-modal>
    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="切换主题"
      title="切换主题"
    >
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.4 15.4A8.5 8.5 0 0 1 8.6 3.6 8.5 8.5 0 1 0 20.4 15.4Z"></path>
      </svg>
    </button>
  </body>
</html>
