---
import "../styles/fonts.css";
import "../styles/global.css";
import { getPublishedPostCatalog } from "../lib/posts";
import { blogSettings } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title: siteTitle,
  headerTitle,
  description: defaultDescription,
  url,
  favicon,
  faviconType,
} = blogSettings.site;
const { github, email } = blogSettings.author;
const footerCopyright = blogSettings.footer.copyright;
const pageData = Astro.props;
const title = pageData.title ? `${pageData.title} | ${siteTitle}` : siteTitle;
const description = pageData.description ?? defaultDescription;
const canonical = new URL(Astro.url.pathname, url);
const path = Astro.url.pathname;
const inArticles = ["/posts/", "/tags/", "/archives/"].some(prefix => path.startsWith(prefix));
const searchEnabled = (await getPublishedPostCatalog()).posts.length > 0;
/* 导航项（含文章菜单触发钮）：移动端更小的点按内边距，≥30rem 恢复桌面尺度 */
const navItemClass =
  "inline-flex min-h-[2.75rem] cursor-pointer items-center border-0 border-b-2 border-b-transparent bg-transparent px-[0.35rem] text-[0.9rem] font-medium tracking-[0.01em] text-muted no-underline hover:border-b-accent hover:text-text min-[30rem]:px-[0.55rem] min-[30rem]:text-[0.9375rem] is-current:border-b-accent is-current:text-text";
/* 文章菜单弹出层条目 */
const menuLinkClass =
  "flex min-h-[2.75rem] items-center px-3 text-[0.9rem] font-medium tracking-[0.01em] text-muted no-underline hover:bg-background hover:text-text";
const structuredData = JSON.stringify(
  path === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteTitle,
        url: canonical.href,
        inLanguage: "zh-CN",
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: pageData.title ?? siteTitle,
        description,
        url: canonical.href,
        inLanguage: "zh-CN",
      },
).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {pageData.noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    {favicon && <link rel="icon" href={favicon} type={faviconType} />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href={new URL("rss.xml", url).href}
    />
    <meta name="theme-color" content="#f5f2ea" />
    <meta property="og:type" content={pageData.ogType ?? "website"} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {searchEnabled && <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />}
    <title>{title}</title>
    <slot name="head">
      {
        !pageData.noindex && (
          <script type="application/ld+json" set:html={structuredData} is:inline />
        )
      }
    </slot>
    {searchEnabled && <script is:inline type="module" src="/pagefind/pagefind-component-ui.js" />}
    <script is:inline>
      (() => {
        const key = "theme";
        const legacyKey = "jasper-theme";
        const root = document.documentElement;

        const systemTheme = () =>
          matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const savedTheme = () => {
          try {
            const saved = localStorage.getItem(key) ?? localStorage.getItem(legacyKey);
            if (saved === "light" || saved === "dark") return saved;
          } catch (error) {
            console.warn("无法读取主题设置，将跟随系统主题。", error);
          }
        };

        const applyResolved = (theme = savedTheme() ?? systemTheme()) => {
          root.dataset.theme = theme;
          const meta = document.querySelector('meta[name="theme-color"]');
          const color = getComputedStyle(root).getPropertyValue("--background").trim();
          if (meta && color) meta.setAttribute("content", color);
        };

        const syncControls = theme => {
          applyResolved(theme);
          const button = document.querySelector("#theme-toggle");
          if (!(button instanceof HTMLButtonElement)) return;
          const current = root.dataset.theme;
          const label = current === "dark" ? "切换至亮色主题" : "切换至暗色主题";
          button.dataset.theme = current;
          button.setAttribute("aria-label", label);
          button.title = label;
        };

        applyResolved();
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => syncControls());
        document.addEventListener("DOMContentLoaded", () => {
          const button = document.querySelector("#theme-toggle");
          if (button instanceof HTMLButtonElement) {
            button.addEventListener("click", () => {
              const next = root.dataset.theme === "dark" ? "light" : "dark";
              try {
                localStorage.setItem(key, next);
                localStorage.removeItem(legacyKey);
              } catch (error) {
                console.warn("无法保存主题设置。", error);
              }
              syncControls(next);
            });
          }
          syncControls();
        });
        addEventListener("load", () => syncControls());
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header relative z-[var(--z-header)]">
      <div
        class="header-inner shell-track grid min-h-[4.25rem] grid-cols-[1fr_auto] items-center gap-[0.15rem_1rem] border-b border-text py-3 min-[52rem]:min-h-[4.5rem] min-[52rem]:gap-x-5 min-[52rem]:py-0"
      >
        <a
          class="brand w-fit text-[1.125rem] font-semibold tracking-[-0.018em] text-text no-underline"
          href="/"
          aria-label={`${headerTitle} 首页`}>{headerTitle}</a
        >
        <nav
          class="col-span-full row-start-2 min-[52rem]:col-span-1 min-[52rem]:row-auto"
          aria-label="主导航"
        >
          <ul
            class="m-0 flex list-none items-center justify-between gap-[clamp(0.2rem,1.5vw,1.25rem)] p-0 min-[52rem]:justify-start"
          >
            <li>
              <div class="article-menu relative" id="article-menu">
                <button
                  id="article-menu-trigger"
                  class={`${navItemClass} gap-[0.3rem]`}
                  type="button"
                  style="anchor-name:--article-menu"
                  popovertarget="article-menu-list"
                  data-active={inArticles || undefined}
                >
                  文章
                  <svg viewBox="0 0 12 12" aria-hidden="true">
                    <path d="m2.5 4 3.5 3.5L9.5 4"></path>
                  </svg>
                </button>
                <ul class="article-menu-list" id="article-menu-list" popover>
                  <li>
                    <a
                      class={menuLinkClass}
                      href="/archives/"
                      aria-current={path.startsWith("/archives/") ? "page" : undefined}
                    >
                      归档
                    </a>
                  </li>
                  <li>
                    <a
                      class={menuLinkClass}
                      href="/tags/"
                      aria-current={path.startsWith("/tags/") ? "page" : undefined}
                    >
                      标签
                    </a>
                  </li>
                </ul>
              </div>
            </li>
            <li>
              <a
                class={navItemClass}
                href="/shuoshuo/"
                aria-current={path.startsWith("/shuoshuo/") ? "page" : undefined}
              >
                说说
              </a>
            </li>
            <li>
              <a
                class={navItemClass}
                href="/about/"
                aria-current={path.startsWith("/about/") ? "page" : undefined}
              >
                关于
              </a>
            </li>
            {
              searchEnabled && (
                <li class="nav-search flex items-center">
                  <pagefind-modal-trigger compact hide-shortcut shortcut="/" placeholder="搜索" />
                </li>
              )
            }
            <li class="contents">
              <button
                class="theme-toggle group grid h-[2.75rem] w-[2.75rem] cursor-pointer place-items-center rounded-full border border-line bg-surface p-0 shadow-[var(--shadow-float)] transition-[border-color,color,background-color,box-shadow,transform] duration-[var(--duration)] ease-[var(--ease-out)] hover:border-accent hover:bg-surface hover:text-accent hover:shadow-[var(--shadow-float-hover)] active:scale-[0.96] min-[52rem]:fixed min-[52rem]:right-[max(1rem,env(safe-area-inset-right,0px))] min-[52rem]:bottom-[max(1rem,env(safe-area-inset-bottom,0px))] min-[52rem]:z-[var(--z-float)]"
                id="theme-toggle"
                type="button"
                aria-label="切换主题"
                title="切换主题"
              >
                <svg
                  class="theme-icon theme-icon-sun block h-[1.15rem] w-[1.15rem] fill-none stroke-current stroke-[1.6] [grid-area:1/1] [stroke-linecap:round] [stroke-linejoin:round] group-data-[theme=dark]:hidden"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="3.5"></circle>
                  <path
                    d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                  ></path>
                </svg>
                <svg
                  class="theme-icon theme-icon-moon hidden h-[1.15rem] w-[1.15rem] fill-none stroke-current stroke-[1.6] [grid-area:1/1] [stroke-linecap:round] [stroke-linejoin:round] group-data-[theme=dark]:block"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M20.4 15.4A8.5 8.5 0 0 1 8.6 3.6 8.5 8.5 0 1 0 20.4 15.4Z"></path>
                </svg>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class={`shell-track flex-1 ${pageData.pageClass ?? ""}`}>
      <slot />
    </main>
    <footer class="site-footer">
      <div
        class="footer-inner shell-track flex min-h-[6.25rem] items-center justify-between gap-x-8 gap-y-4 border-t border-line py-7 text-[0.82rem] tracking-[0.01em] text-muted max-[30rem]:flex-col max-[30rem]:items-start [&_p]:m-0 [&_p+p]:mt-2"
      >
        {
          footerCopyright && (
            <div class="footer-content min-w-0 [overflow-wrap:anywhere]">{footerCopyright}</div>
          )
        }
        <ul
          class="m-0 ml-auto flex shrink-0 list-none gap-5 p-0 max-[30rem]:ml-0"
          aria-label="联系方式"
        >
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href={github}>GitHub</a></li>
          <li>
            <a href={`mailto:${email}`}>邮箱</a>
          </li>
        </ul>
      </div>
    </footer>
    {
      searchEnabled && (
        <>
          {/* ponytail: 当前索引很小；内容规模明显增长时再恢复 Worker。 */}
          <pagefind-config no-worker lang="zh-cn" />
          <pagefind-modal reset-on-close>
            <pagefind-modal-header>
              <pagefind-input placeholder="搜索技术文章" />
            </pagefind-modal-header>
            <pagefind-modal-body>
              <pagefind-summary />
              <pagefind-results hide-sub-results />
            </pagefind-modal-body>
            <pagefind-modal-footer>
              <pagefind-keyboard-hints />
            </pagefind-modal-footer>
          </pagefind-modal>
        </>
      )
    }
    <style>
      /* 文章菜单弹出层：CSS 锚点定位无法用工具类表达，保留为集成样式 */
      .article-menu-list {
        position: fixed;
        position-anchor: --article-menu;
        inset: auto;
        top: calc(anchor(bottom) + 0.35rem);
        left: anchor(center);
        width: 9rem;
        margin: 0;
        padding: 0.5rem;
        border: 1px solid var(--line);
        border-radius: 0.65rem;
        background: var(--surface);
        box-shadow: var(--shadow-menu);
        transform: translateX(-50%);
      }

      .article-menu-list a[aria-current="page"] {
        background: var(--background);
        color: var(--text);
      }

      @media (max-width: 30rem) {
        .article-menu-list {
          left: anchor(left);
          transform: none;
        }
      }

      .article-menu > button svg {
        width: 0.75rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.5;
        transition: transform var(--duration) var(--ease-out);
      }

      .article-menu:has(.article-menu-list:popover-open) > button svg {
        transform: rotate(180deg);
      }
    </style>
    <div class="paper-grain" aria-hidden="true"></div>
  </body>
</html>
