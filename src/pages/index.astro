---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../lib/posts";
import { getPublishedShuoshuo } from "../lib/shuoshuo";
import { blogSettings } from "../lib/site";

const [{ posts: publishedPosts }, publishedShuoshuo] = await Promise.all([
  getPublishedPostCatalog(),
  getPublishedShuoshuo(),
]);
const [latestPost] = publishedPosts;
const [latestShuoshuo] = publishedShuoshuo;
const { hero } = blogSettings.home;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <h1 id="home-title" class="hero-caption">{hero.caption}</h1>

    <div class="hero-media">
      <img
        class="hero-image"
        id="hero-image"
        data-hero-images={JSON.stringify(hero.images)}
        width="1248"
        height="832"
        alt={hero.alt}
        decoding="async"
        fetchpriority="high"
      />
      <script is:inline>
        (() => {
          const image = document.querySelector("#hero-image");
          if (!(image instanceof HTMLImageElement)) return;
          const pool = JSON.parse(image.dataset.heroImages ?? "[]");
          const reveal = () => (image.dataset.loaded = "true");
          image.addEventListener("load", reveal, { once: true });
          image.addEventListener("error", reveal, { once: true });
          image.src = pool[Math.floor(Math.random() * pool.length)];
          if (image.complete) reveal();
        })();
      </script>
      <noscript>
        <img
          class="hero-image"
          src={hero.images[0]}
          width="1248"
          height="832"
          alt={hero.alt}
          decoding="async"
          fetchpriority="high"
        />
      </noscript>
    </div>

    <div class:list={["home-feed", { "home-feed-posts-empty": !latestPost }]}>
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          <a href="/archives/">查看全部 ({postCount})</a>
        </div>
        {
          latestPost ? (
            <article class="post-preview">
              <time datetime={latestPost.publishedAt.iso}>{latestPost.publishedAt.compact}</time>
              <h3>
                <a href={latestPost.href}>{latestPost.title}</a>
              </h3>
              {latestPost.description ? (
                <p class="post-preview-description">{latestPost.description}</p>
              ) : null}
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="feed-section feed-shuoshuo" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          <a href="/shuoshuo/">查看全部 ({shuoshuoCount})</a>
        </div>
        {
          latestShuoshuo ? (
            <article aria-label={latestShuoshuo.label}>
              <a class="shuoshuo-preview" href={latestShuoshuo.href}>
                <time datetime={latestShuoshuo.publishedAt.iso}>
                  {latestShuoshuo.publishedAt.compact}
                </time>
                <p>{latestShuoshuo.preview}</p>
              </a>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
      <script is:inline>
        (() => {
          // 贴底的说说区放不下时会向上溢出；按区内剩余高度设置行数，截断处出现省略号。
          const text = document.querySelector(".shuoshuo-preview p");
          const section = text?.closest(".feed-section");
          const heading = section?.querySelector(".section-heading");
          if (!text || !section || !heading) return;
          const fit = () => {
            if (getComputedStyle(section).display !== "flex") {
              text.style.removeProperty("-webkit-line-clamp");
              return;
            }
            // 区头到正文顶部的距离与正文行数无关，剩下的高度全部留给正文。
            const above = text.getBoundingClientRect().top - heading.getBoundingClientRect().top;
            const available =
              section.clientHeight - parseFloat(getComputedStyle(section).paddingTop) - above;
            const lines = Math.floor(
              (available + 0.5) / parseFloat(getComputedStyle(text).lineHeight),
            );
            text.style.setProperty("-webkit-line-clamp", String(Math.max(lines, 1)));
          };
          new ResizeObserver(fit).observe(section);
          document.fonts?.ready.then(fit);
        })();
      </script>
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * 双行两栏：行1 caption | 空；行2 图 | 信息流。
   * 桌面信息流贴合影像上下沿，说说正文末行与影像下沿对齐，放不下的文字按整行截断。
   */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(2.5rem, 4vw, 4.5rem);
    row-gap: 1.45rem;
    align-items: start;
  }

  .hero-caption {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: clamp(1.8rem, 3.2vw, 2.45rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: var(--leading-display);
    font-optical-sizing: auto;
  }

  .hero-media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    align-self: start;
    width: 100%;
    min-width: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.65rem;
    background: var(--surface);
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    pointer-events: none;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #hero-image:not([src]) {
    display: none;
  }

  /* 只作用于脚本注入的主图；noscript 回退图同用 .hero-image，不能被隐藏。 */
  @media (prefers-reduced-motion: no-preference) {
    #hero-image {
      transition: opacity 400ms var(--ease-out);
    }

    #hero-image:not([data-loaded]) {
      opacity: 0;
    }
  }

  /*
   * 信息流贴合影像上下沿：文章区按内容定高；说说区占满剩余高度并贴底，
   * 正文末行落在影像下沿，说说较短时余量留在两区之间。
   * height: 0 避免信息流撑开行高，min-height: 100% 再贴合影像。
   */
  .home-feed {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 0;
    min-height: 100%;
    min-width: 0;
  }

  .feed-section {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* padding-top 是两区的最小间隔；脚本按剩余高度截断说说，保证区内放得下。 */
  .feed-shuoshuo {
    flex: 1 1 0;
    justify-content: flex-end;
    min-height: 0;
    padding-top: 1.75rem;
  }

  /* 分区线挂在区头上，随贴底的说说一起移动。 */
  .section-heading {
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.625rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--text) 30%, var(--line));
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .section-heading a {
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none;
  }

  .section-heading a:hover {
    color: var(--text);
  }

  .section-heading a:active,
  .post-preview h3 a:active {
    transform: translateY(1px);
  }

  .post-preview {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-preview h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.42;
    overflow-wrap: anywhere;
    font-optical-sizing: auto;
  }

  .post-preview h3 a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .post-preview-description {
    margin: 0.2rem 0 0;
    color: var(--muted);
    overflow-wrap: anywhere;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    line-height: 1.65;
  }

  /* 与文章预览同构的扁平札记：日期 + 正文，不加卡片、阴影或装饰边线。 */
  .shuoshuo-preview {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }

  .shuoshuo-preview:active {
    transform: translateY(1px);
  }

  /* 无脚本时固定 3 行；脚本按区内剩余高度改写行数。 */
  .shuoshuo-preview p {
    margin: 0;
    font-family: var(--font-sans);
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
    overflow-wrap: anywhere;
    transition: color var(--duration) var(--ease-out);
  }

  .shuoshuo-preview:hover p {
    color: var(--accent);
  }

  .post-preview time,
  .shuoshuo-preview time {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  /* 窄桌面信息流只有约 20rem 高，缩小两区间隔，至少留出一行说说。 */
  @media (max-width: 64rem) {
    .feed-shuoshuo {
      padding-top: 1.25rem;
    }
  }

  @media (max-width: 52rem) {
    .home-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      column-gap: 0;
      row-gap: 2rem;
    }

    .hero-caption,
    .hero-media,
    .home-feed {
      grid-column: 1;
      grid-row: auto;
    }

    .hero-caption {
      order: 1;
    }

    .home-feed {
      order: 2;
      gap: 1.5rem;
      height: auto;
      min-height: 0;
    }

    .hero-media {
      order: 3;
      max-width: 28rem;
    }

    .home-feed-posts-empty .feed-section:first-child {
      order: 2;
    }

    .feed-section,
    .feed-shuoshuo {
      display: block;
      flex: none;
      padding-top: 0;
    }

    .section-heading {
      margin-bottom: 0.5rem;
      padding-top: 0.5rem;
    }

    /* 单栏多为触屏，链接保留 2.75rem 触控高度。 */
    .section-heading a,
    .post-preview h3 a {
      min-height: 2.75rem;
    }

    .post-preview {
      gap: 0;
    }
  }
</style>

<style is:global>
  .home {
    padding-block: var(--space-page-top) var(--space-page-bottom);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-caption,
    .home-feed {
      animation: home-rise 700ms var(--ease-out) both;
    }

    .home-feed {
      animation-delay: 90ms;
    }
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 52rem) {
    .home {
      padding-block: 3rem 5.25rem;
    }
  }
</style>
