---
import BaseLayout from "../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { formatPostDateCompact, getPublishedPosts } from "../lib/posts";
import { getPublishedShuoshuo, getShuoshuoLabel } from "../lib/shuoshuo";
import { siteConfig } from "../lib/site";

const publishedPosts = await getPublishedPosts();
const publishedShuoshuo = await getPublishedShuoshuo();
const [latestPost] = publishedPosts;
const [latestShuoshuo] = publishedShuoshuo;
const LatestShuoshuoContent = latestShuoshuo ? (await render(latestShuoshuo)).Content : undefined;
const { hero } = siteConfig;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <section class="hero" aria-labelledby="home-title">
      <h1 id="home-title" class="hero-caption">{hero.caption}</h1>
      <img
        class="hero-image hero-image-light"
        src={hero.src}
        width={hero.width}
        height={hero.height}
        alt={hero.alt}
        decoding="async"
        fetchpriority="high"
      />
      <img
        class="hero-image hero-image-dark"
        src={hero.srcDark}
        width={hero.width}
        height={hero.height}
        alt={hero.alt}
        decoding="async"
      />
    </section>

    <div class="home-feed">
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          <a href="/archives/">查看全部 ({postCount})</a>
        </div>
        {
          latestPost ? (
            <article class="post-preview">
              <time datetime={latestPost.data.publishedAt.toISOString()}>
                {formatPostDateCompact(latestPost.data.publishedAt)}
              </time>
              <h3>
                <a href={`/posts/${latestPost.id}/`}>{latestPost.data.title}</a>
              </h3>
              <p class="post-preview-description">{latestPost.data.description}</p>
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="feed-section" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          <a href="/shuoshuo/">查看全部 ({shuoshuoCount})</a>
        </div>
        {
          latestShuoshuo && LatestShuoshuoContent ? (
            <article
              class="shuoshuo-preview"
              aria-label={getShuoshuoLabel(latestShuoshuo.data.publishedAt)}
            >
              <div class="post-body shuoshuo-body shuoshuo-summary">
                <LatestShuoshuoContent />
              </div>
              <a href={`/shuoshuo/#${latestShuoshuo.id}`}>
                <time datetime={latestShuoshuo.data.publishedAt.toISOString()}>
                  {getShuoshuoLabel(latestShuoshuo.data.publishedAt)}
                </time>
              </a>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const summary = document.querySelector(".shuoshuo-summary");
  if (summary instanceof HTMLDivElement) {
    const accessibleSummary = document.createElement("p");
    accessibleSummary.className = "sr-only";
    accessibleSummary.textContent = summary.textContent.trim();
    summary.before(accessibleSummary);
    summary.toggleAttribute("data-collapsed", true);
    summary.inert = true;
    summary.setAttribute("aria-hidden", "true");
  }
</script>
