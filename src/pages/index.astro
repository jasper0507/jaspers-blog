---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../lib/posts";
import { getPublishedShuoshuo } from "../lib/shuoshuo";
import { blogSettings } from "../lib/site";
import "../styles/shuoshuo-card.css";

const [{ posts: publishedPosts }, publishedShuoshuo] = await Promise.all([
  getPublishedPostCatalog(),
  getPublishedShuoshuo(),
]);
const [latestPost] = publishedPosts;
const [latestShuoshuo] = publishedShuoshuo;
const { hero } = blogSettings.home;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <h1 id="home-title" class="hero-caption">{hero.caption}</h1>

    <div class="hero-media">
      <img
        class="hero-image"
        id="hero-image"
        data-hero-images={JSON.stringify(hero.images)}
        width="1248"
        height="832"
        alt={hero.alt}
        decoding="async"
        fetchpriority="high"
      />
      <script is:inline>
        (() => {
          const image = document.querySelector("#hero-image");
          if (!(image instanceof HTMLImageElement)) return;
          const pool = JSON.parse(image.dataset.heroImages ?? "[]");
          image.src = pool[Math.floor(Math.random() * pool.length)];
        })();
      </script>
      <noscript>
        <img
          class="hero-image"
          src={hero.images[0]}
          width="1248"
          height="832"
          alt={hero.alt}
          decoding="async"
          fetchpriority="high"
        />
      </noscript>
    </div>

    <div class:list={["home-feed", { "home-feed-posts-empty": !latestPost }]}>
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          <a href="/archives/">查看全部 ({postCount})</a>
        </div>
        {
          latestPost ? (
            <article class="post-preview">
              <time datetime={latestPost.publishedAt.iso}>{latestPost.publishedAt.compact}</time>
              <h3>
                <a href={latestPost.href}>{latestPost.title}</a>
              </h3>
              <p class="post-preview-description">{latestPost.description}</p>
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="feed-section" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          <a href="/shuoshuo/">查看全部 ({shuoshuoCount})</a>
        </div>
        {
          latestShuoshuo ? (
            <article aria-label={latestShuoshuo.label}>
              <a class="post-preview shuoshuo-preview" href={latestShuoshuo.href}>
                <time datetime={latestShuoshuo.publishedAt.iso}>
                  {latestShuoshuo.publishedAt.compact}
                </time>
                <h3>{latestShuoshuo.summary}</h3>
              </a>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * 双行两栏：行1 caption | 空；行2 图 | 信息流。
   * 桌面信息流贴合影像上下沿；说说按内容高度贴底，文章占剩余空间。
   */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(2.5rem, 4vw, 4.5rem);
    row-gap: 1.45rem;
    align-items: start;
  }

  .hero-caption {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    color: var(--text);
    font-family: "Songti SC", STSong, "Noto Serif CJK SC", SimSun, serif;
    font-size: clamp(1.8rem, 3.2vw, 2.45rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: var(--leading-display);
    font-optical-sizing: auto;
  }

  .hero-media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    align-self: start;
    width: 100%;
    min-width: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.65rem;
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    pointer-events: none;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* height: 0 避免信息流撑开行高，min-height: 100% 再贴合影像 */
  .home-feed {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0;
    width: 100%;
    height: 0;
    min-height: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .feed-section {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    min-height: 0;
    overflow: auto;
    padding-top: 1rem;
    padding-bottom: 0.35rem;
    border-top: 1px solid var(--text);
  }

  .feed-section:last-child {
    overflow: hidden;
    padding-bottom: 0.35rem;
  }

  .section-heading {
    margin-bottom: 0.75rem;
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .feed-section:last-child .section-heading {
    margin-bottom: 0.55rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .section-heading a {
    color: var(--muted);
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none;
  }

  .section-heading a:hover {
    color: var(--text);
  }

  .section-heading a:active,
  .post-preview h3 a:active {
    transform: translateY(1px);
  }

  .post-preview {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .post-preview h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.42;
    overflow-wrap: anywhere;
    font-optical-sizing: auto;
  }

  .feed-section:first-child .post-preview h3 {
    font-size: 1.215rem;
  }

  .post-preview h3 a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
  }

  .post-preview.shuoshuo-preview {
    color: inherit;
    text-decoration: none;
  }

  .post-preview p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .post-preview-description {
    margin: 0;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    line-height: 1.65;
  }

  .post-preview time,
  .shuoshuo-preview time {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  @media (max-width: 52rem) {
    .home-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      column-gap: 0;
      row-gap: 2rem;
    }

    .hero-caption,
    .hero-media,
    .home-feed {
      grid-column: 1;
      grid-row: auto;
    }

    .hero-caption {
      order: 1;
    }

    .home-feed {
      order: 2;
      display: grid;
      grid-template-rows: none;
      gap: 2rem;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .hero-media {
      order: 3;
      max-width: 28rem;
    }

    .home-feed-posts-empty .feed-section:first-child {
      order: 2;
    }

    .feed-section,
    .feed-section:last-child {
      display: block;
      overflow: visible;
      padding-top: 1.25rem;
      padding-bottom: 0;
      border-bottom: none;
    }

    .section-heading,
    .feed-section:last-child .section-heading {
      margin-bottom: 1.25rem;
    }

    .post-preview-description {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }
</style>

<style is:global>
  .home {
    padding-block: var(--space-page-top) var(--space-page-bottom);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-caption,
    .home-feed {
      animation: home-rise 700ms var(--ease-out) both;
    }

    .home-feed {
      animation-delay: 90ms;
    }
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 52rem) {
    .home {
      padding-block: 3rem 5.25rem;
    }
  }
</style>
