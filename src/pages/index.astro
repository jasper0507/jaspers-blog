---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../lib/posts";
import { getPublishedShuoshuo } from "../lib/shuoshuo";
import { blogSettings } from "../lib/site";

const [{ posts: publishedPosts }, publishedShuoshuo] = await Promise.all([
  getPublishedPostCatalog(),
  getPublishedShuoshuo(),
]);
const [latestPost] = publishedPosts;
const [latestShuoshuo] = publishedShuoshuo;
const { hero } = blogSettings.home;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <h1 id="home-title" class="hero-caption">{hero.caption}</h1>

    <div class="hero-media">
      <img
        class="hero-image"
        id="hero-image"
        data-hero-images={JSON.stringify(hero.images)}
        width="1248"
        height="832"
        alt={hero.alt}
        decoding="async"
        fetchpriority="high"
      />
      <script is:inline>
        (() => {
          const image = document.querySelector("#hero-image");
          if (!(image instanceof HTMLImageElement)) return;
          const pool = JSON.parse(image.dataset.heroImages ?? "[]");
          const reveal = () => (image.dataset.loaded = "true");
          image.addEventListener("load", reveal, { once: true });
          image.addEventListener("error", reveal, { once: true });
          image.src = pool[Math.floor(Math.random() * pool.length)];
          if (image.complete) reveal();
        })();
      </script>
      <noscript>
        <img
          class="hero-image"
          src={hero.images[0]}
          width="1248"
          height="832"
          alt={hero.alt}
          decoding="async"
          fetchpriority="high"
        />
      </noscript>
    </div>

    <div class:list={["home-feed", { "home-feed-posts-empty": !latestPost }]}>
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          {
            latestPost && (
              <time datetime={latestPost.publishedAt.iso}>{latestPost.publishedAt.compact}</time>
            )
          }
        </div>
        {
          latestPost ? (
            <article class="feed-item post-preview">
              <h3>
                <a href={latestPost.href}>{latestPost.title}</a>
              </h3>
              {latestPost.description ? (
                <div class="feed-clip">
                  <p class="post-preview-description">{latestPost.description}</p>
                </div>
              ) : null}
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
        <a class="section-more" href="/archives/">查看全部 ({postCount})</a>
      </section>

      <section class="feed-section" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          {
            latestShuoshuo && (
              <time datetime={latestShuoshuo.publishedAt.iso}>
                {latestShuoshuo.publishedAt.compact}
              </time>
            )
          }
        </div>
        {
          latestShuoshuo ? (
            <article class="feed-item" aria-label={latestShuoshuo.label}>
              <div class="feed-clip">
                <a class="shuoshuo-preview" href={latestShuoshuo.href}>
                  <p>{latestShuoshuo.preview}</p>
                </a>
              </div>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
        <a class="section-more" href="/shuoshuo/">查看全部 ({shuoshuoCount})</a>
      </section>
      <script is:inline>
        (() => {
          // CSS 只能按整行裁剪；按截断区高度设置行数，让截断处出现省略号。
          const fit = box => {
            const text = box.querySelector("p");
            if (!text) return;
            if (getComputedStyle(box).containerType !== "size") {
              text.style.removeProperty("-webkit-line-clamp");
              return;
            }
            // 与 CSS 的 round(down, 100cqh, 1lh) 取同一行数，省略号才会落在最后一行。
            const lines = Math.floor(
              box.clientHeight / parseFloat(getComputedStyle(text).lineHeight),
            );
            text.style.setProperty("-webkit-line-clamp", String(Math.max(lines, 1)));
          };
          const observer = new ResizeObserver(entries => {
            for (const entry of entries) fit(entry.target);
          });
          for (const box of document.querySelectorAll(".feed-clip")) observer.observe(box);
        })();
      </script>
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * 双行两栏：行1 caption | 空；行2 图 | 信息流。
   * 桌面信息流贴合影像上下沿，两区平分高度，放不下的文字按整行截断。
   */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(2.5rem, 4vw, 4.5rem);
    row-gap: 1.45rem;
    align-items: start;
  }

  .hero-caption {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: clamp(1.8rem, 3.2vw, 2.45rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: var(--leading-display);
    font-optical-sizing: auto;
  }

  .hero-media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    align-self: start;
    width: 100%;
    min-width: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.65rem;
    background: var(--surface);
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    pointer-events: none;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #hero-image:not([src]) {
    display: none;
  }

  /* 只作用于脚本注入的主图；noscript 回退图同用 .hero-image，不能被隐藏。 */
  @media (prefers-reduced-motion: no-preference) {
    #hero-image {
      transition: opacity 400ms var(--ease-out);
    }

    #hero-image:not([data-loaded]) {
      opacity: 0;
    }
  }

  /*
   * 信息流贴合影像上下沿，两区平分高度，分区线位置固定。
   * 每区上有区头（标题 + 日期）、下有「查看全部」，内容少时也有完整轮廓；
   * 正文在两者之间按整行截断，与底部链接保持固定间隔。说说区的底部链接落在影像下沿。
   * height: 0 避免信息流撑开行高，min-height: 100% 再贴合影像。
   */
  .home-feed {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    width: 100%;
    height: 0;
    min-height: 100%;
    min-width: 0;
  }

  .feed-section {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding-top: 0.875rem;
    border-top: 1px solid color-mix(in srgb, var(--text) 30%, var(--line));
  }

  /* 文章区底部到分区线的留白；说说区贴底，不留。 */
  .feed-section:first-of-type {
    padding-bottom: 1.25rem;
  }

  .section-heading {
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .section-heading time {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
    white-space: nowrap;
  }

  .feed-item {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    min-height: 0;
  }

  /* 截断区是尺寸容器：高度由区内剩余空间决定，round(down, 100cqh, 1lh) 只保留完整的行。 */
  .feed-clip {
    flex: 1 1 0;
    min-height: 0;
    container-type: size;
  }

  .feed-clip p {
    margin: 0;
    display: -webkit-box;
    max-height: round(down, 100cqh, 1lh);
    overflow: hidden;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
  }

  .post-preview h3 {
    margin: 0;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.42;
    overflow-wrap: anywhere;
    font-optical-sizing: auto;
  }

  .post-preview h3 a {
    text-decoration: none;
  }

  .post-preview-description {
    color: var(--muted);
    line-height: 1.65;
  }

  /* 与文章预览同构的扁平札记，不加卡片、阴影或装饰边线。 */
  .shuoshuo-preview {
    display: block;
    color: var(--text);
    text-decoration: none;
  }

  .shuoshuo-preview p {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
    transition: color var(--duration) var(--ease-out);
  }

  .shuoshuo-preview:hover p {
    color: var(--accent);
  }

  /* margin-top: auto 把链接压到区底；padding-top 是正文截断后的最小间隔。 */
  .section-more {
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    line-height: 1.5;
    white-space: nowrap;
    text-decoration: none;
  }

  .section-more:hover {
    color: var(--text);
  }

  .section-more:active,
  .post-preview h3 a:active,
  .shuoshuo-preview:active {
    transform: translateY(1px);
  }

  /* 窄桌面信息流只有约 20rem 高，收紧留白，至少留出一行说说。 */
  @media (max-width: 64rem) {
    .feed-section {
      padding-top: 0.75rem;
    }

    .feed-section:first-of-type {
      padding-bottom: 1rem;
    }

    .section-more {
      padding-top: 0.5rem;
    }
  }

  @media (max-width: 52rem) {
    .home-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      column-gap: 0;
      row-gap: 2rem;
    }

    .hero-caption,
    .hero-media,
    .home-feed {
      grid-column: 1;
      grid-row: auto;
    }

    .hero-caption {
      order: 1;
    }

    .home-feed {
      order: 2;
      grid-template-rows: none;
      gap: 1.5rem;
      height: auto;
      min-height: 0;
    }

    .hero-media {
      order: 3;
      max-width: 28rem;
    }

    .home-feed-posts-empty .feed-section:first-child {
      order: 2;
    }

    .feed-section,
    .feed-section:first-of-type {
      display: block;
      padding-block: 1rem 0;
    }

    .feed-item,
    .feed-clip {
      display: block;
      flex: none;
      container-type: normal;
    }

    .feed-clip p {
      max-height: none;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }

    .post-preview-description {
      margin-top: 0.35rem;
    }

    .post-preview .feed-clip p {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    /* 单栏多为触屏，链接保留 2.75rem 触控高度。 */
    .section-more,
    .post-preview h3 a,
    .shuoshuo-preview {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
    }

    .section-more {
      width: fit-content;
      padding-top: 0;
    }
  }
</style>

<style is:global>
  .home {
    padding-block: var(--space-page-top) var(--space-page-bottom);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-caption,
    .home-feed {
      animation: home-rise 700ms var(--ease-out) both;
    }

    .home-feed {
      animation-delay: 90ms;
    }
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 52rem) {
    .home {
      padding-block: 3rem 5.25rem;
    }
  }
</style>
