---
import BaseLayout from "../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { formatPostDate, getPublishedPosts } from "../lib/posts";
import {
  getPublishedShuoshuo,
  getShuoshuoLabel,
} from "../lib/shuoshuo";

const [latestPost] = await getPublishedPosts();
const [latestShuoshuo] = await getPublishedShuoshuo();
const LatestShuoshuoContent = latestShuoshuo
  ? (await render(latestShuoshuo)).Content
  : undefined;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <section class="hero" aria-labelledby="home-title">
      <p class="hero-kicker">JASPER'S BLOG</p>
      <h1 id="home-title">
        <span>见了便做，</span>
        <span>做了便放下，</span>
        <span>了了有何不了。</span>
      </h1>
    </section>

    <div class="home-feed">
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          <a href="/posts/">查看全部</a>
        </div>
        {
          latestPost ? (
            <article class="post-preview">
              <h3>
                <a href={`/posts/${latestPost.id}/`}>{latestPost.data.title}</a>
              </h3>
              <p>{latestPost.data.description}</p>
              <time datetime={latestPost.data.publishedAt.toISOString()}>
                {formatPostDate(latestPost.data.publishedAt)}
              </time>
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="feed-section" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          <a href="/shuoshuo/">查看全部</a>
        </div>
        {
          latestShuoshuo && LatestShuoshuoContent ? (
            <article
              class="shuoshuo-preview"
              aria-label={getShuoshuoLabel(latestShuoshuo.data.publishedAt)}
            >
              <div
                class="post-body shuoshuo-body shuoshuo-summary"
              >
                <LatestShuoshuoContent />
              </div>
              <a href={`/shuoshuo/#${latestShuoshuo.id}`}>
                <time datetime={latestShuoshuo.data.publishedAt.toISOString()}>
                  {getShuoshuoLabel(latestShuoshuo.data.publishedAt)}
                </time>
              </a>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const summary = document.querySelector(".shuoshuo-summary");
  if (summary instanceof HTMLDivElement) {
    const accessibleSummary = document.createElement("p");
    accessibleSummary.className = "sr-only";
    accessibleSummary.textContent = summary.textContent.trim();
    summary.before(accessibleSummary);
    summary.toggleAttribute("data-collapsed", true);
    summary.inert = true;
    summary.setAttribute("aria-hidden", "true");
  }
</script>
