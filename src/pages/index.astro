---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../lib/posts";
import { getPublishedShuoshuo } from "../lib/shuoshuo";
import { blogSettings } from "../lib/site";

const [{ posts: publishedPosts }, publishedShuoshuo] = await Promise.all([
  getPublishedPostCatalog(),
  getPublishedShuoshuo(),
]);
const [latestPost] = publishedPosts;
const [latestShuoshuo] = publishedShuoshuo;
const { hero } = blogSettings.home;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <h1 id="home-title" class="hero-caption">{hero.caption}</h1>

    <div class="hero-media">
      <img
        class="hero-image"
        id="hero-image"
        data-hero-images={JSON.stringify(hero.images)}
        width="1248"
        height="832"
        alt={hero.alt}
        decoding="async"
        fetchpriority="high"
      />
      <script is:inline>
        (() => {
          const image = document.querySelector("#hero-image");
          if (!(image instanceof HTMLImageElement)) return;
          const pool = JSON.parse(image.dataset.heroImages ?? "[]");
          const reveal = () => (image.dataset.loaded = "true");
          image.addEventListener("load", reveal, { once: true });
          image.addEventListener("error", reveal, { once: true });
          image.src = pool[Math.floor(Math.random() * pool.length)];
          if (image.complete) reveal();
        })();
      </script>
      <noscript>
        <img
          class="hero-image"
          src={hero.images[0]}
          width="1248"
          height="832"
          alt={hero.alt}
          decoding="async"
          fetchpriority="high"
        />
      </noscript>
    </div>

    <div class:list={["home-feed", { "home-feed-posts-empty": !latestPost }]}>
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          <a href="/archives/">查看全部 ({postCount})</a>
        </div>
        {
          latestPost ? (
            <article class="post-preview">
              <time datetime={latestPost.publishedAt.iso}>{latestPost.publishedAt.compact}</time>
              <h3>
                <a href={latestPost.href}>{latestPost.title}</a>
              </h3>
              {latestPost.description ? (
                <div class="post-preview-summary">
                  <p class="post-preview-description">{latestPost.description}</p>
                </div>
              ) : null}
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="feed-section" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          <a href="/shuoshuo/">查看全部 ({shuoshuoCount})</a>
        </div>
        {
          latestShuoshuo ? (
            <article aria-label={latestShuoshuo.label}>
              <a class="shuoshuo-preview" href={latestShuoshuo.href}>
                <time datetime={latestShuoshuo.publishedAt.iso}>
                  {latestShuoshuo.publishedAt.compact}
                </time>
                <div class="shuoshuo-preview-text">
                  <p>
                    {latestShuoshuo.preview.map((segment, index) => [
                      index > 0 && <span class="image-token">图片</span>,
                      segment,
                    ])}
                  </p>
                </div>
              </a>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
      <script is:inline>
        (() => {
          // CSS 只能按整行裁剪；按剩余高度设置行数，让截断处出现省略号。
          const texts = document.querySelectorAll(".post-preview-description, .shuoshuo-preview p");
          const fit = text => {
            const box = text.parentElement;
            if (getComputedStyle(box).containerType !== "size") {
              text.style.removeProperty("-webkit-line-clamp");
              return;
            }
            const lines = Math.floor(
              box.clientHeight / parseFloat(getComputedStyle(text).lineHeight),
            );
            text.style.setProperty("-webkit-line-clamp", String(Math.max(lines, 1)));
          };
          const observer = new ResizeObserver(entries => {
            for (const entry of entries) fit(entry.target.firstElementChild);
          });
          for (const text of texts) observer.observe(text.parentElement);
        })();
      </script>
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * 双行两栏：行1 caption | 空；行2 图 | 信息流。
   * 桌面信息流贴合影像上下沿；文章与说说各占一半固定高度，放不下的文字按整行截断。
   */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(2.5rem, 4vw, 4.5rem);
    row-gap: 1.45rem;
    align-items: start;
  }

  .hero-caption {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: clamp(1.8rem, 3.2vw, 2.45rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: var(--leading-display);
    font-optical-sizing: auto;
  }

  .hero-media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    align-self: start;
    width: 100%;
    min-width: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.65rem;
    background: var(--surface);
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    pointer-events: none;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #hero-image:not([src]) {
    display: none;
  }

  /* 只作用于脚本注入的主图；noscript 回退图同用 .hero-image，不能被隐藏。 */
  @media (prefers-reduced-motion: no-preference) {
    #hero-image {
      transition: opacity 400ms var(--ease-out);
    }

    #hero-image:not([data-loaded]) {
      opacity: 0;
    }
  }

  /* height: 0 避免信息流撑开行高，min-height: 100% 再贴合影像 */
  .home-feed {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    width: 100%;
    height: 0;
    min-height: 100%;
    min-width: 0;
    /* 说说链接的焦点轮廓会伸出分区边缘。 */
    overflow: visible;
  }

  .feed-section {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding-top: 1rem;
    padding-bottom: 0.35rem;
    border-top: 1px solid color-mix(in srgb, var(--text) 30%, var(--line));
  }

  .feed-section:last-child {
    overflow: visible;
    padding-bottom: 0.35rem;
  }

  .section-heading {
    margin-bottom: 0.75rem;
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .feed-section:last-child .section-heading {
    margin-bottom: 0.55rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .section-heading a {
    color: var(--muted);
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none;
  }

  .section-heading a:hover {
    color: var(--text);
  }

  .section-heading a:active,
  .post-preview h3 a:active {
    transform: translateY(1px);
  }

  .post-preview {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    min-height: 0;
  }

  /*
   * 摘要区与便签正文是尺寸容器：高度由分区剩余空间决定，
   * 内部文字用 round(down, 100cqh, 1lh) 只保留完整的行，避免露出半行。
   */
  .post-preview-summary,
  .shuoshuo-preview-text {
    flex: 1 1 0;
    min-height: 0;
    container-type: size;
  }

  .feed-section > article:not(.post-preview) {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-height: 0;
  }

  .post-preview h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.42;
    overflow-wrap: anywhere;
    font-optical-sizing: auto;
  }

  .post-preview h3 a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
  }

  /* 与文章预览同构的扁平札记：日期 + 正文，不加卡片、阴影或装饰边线。 */
  .shuoshuo-preview {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    min-height: 0;
    color: var(--text);
    text-decoration: none;
  }

  .shuoshuo-preview:active {
    transform: translateY(1px);
  }

  .shuoshuo-preview p {
    margin: 0;
    font-family: var(--font-sans);
    display: -webkit-box;
    max-height: round(down, 100cqh, 1lh);
    overflow: hidden;
    -webkit-box-orient: vertical;
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
    overflow-wrap: anywhere;
    transition: color var(--duration) var(--ease-out);
  }

  .shuoshuo-preview:hover p {
    color: var(--accent);
  }

  /* 图片在原文中的位置；只是文字占位，不加载图片。 */
  .image-token {
    display: inline-block;
    margin-inline: 0.2em;
    padding: 0 0.4em;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    color: var(--muted);
    font-size: 0.78em;
    letter-spacing: 0.04em;
    line-height: 1.55;
    vertical-align: 0.12em;
    white-space: nowrap;
  }

  .post-preview-summary {
    margin-top: 0.45rem;
  }

  .post-preview-description {
    margin: 0;
    color: var(--muted);
    overflow-wrap: anywhere;
    max-height: round(down, 100cqh, 1lh);
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    line-height: 1.65;
  }

  .post-preview time,
  .shuoshuo-preview time {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  /* 窄桌面信息流只有约 20rem 高，收紧便签留白，至少留出一行说说。 */
  @media (max-width: 64rem) {
    .feed-section {
      padding-top: 0.75rem;
    }

    .shuoshuo-preview {
      gap: 0.35rem;
    }
  }

  @media (max-width: 52rem) {
    .home-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      column-gap: 0;
      row-gap: 2rem;
    }

    .hero-caption,
    .hero-media,
    .home-feed {
      grid-column: 1;
      grid-row: auto;
    }

    .hero-caption {
      order: 1;
    }

    .home-feed {
      order: 2;
      display: grid;
      grid-template-rows: none;
      gap: 2rem;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .hero-media {
      order: 3;
      max-width: 28rem;
    }

    .home-feed-posts-empty .feed-section:first-child {
      order: 2;
    }

    .post-preview,
    .post-preview-summary,
    .feed-section > article:not(.post-preview),
    .shuoshuo-preview,
    .shuoshuo-preview-text {
      flex: none;
      container-type: normal;
    }

    .post-preview-description,
    .shuoshuo-preview p {
      max-height: none;
    }

    .feed-section,
    .feed-section:last-child {
      display: block;
      overflow: visible;
      padding-top: 1.25rem;
      padding-bottom: 0;
      border-bottom: none;
    }

    .section-heading,
    .feed-section:last-child .section-heading {
      margin-bottom: 1.25rem;
    }

    .post-preview-description {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .shuoshuo-preview p {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }
</style>

<style is:global>
  .home {
    padding-block: var(--space-page-top) var(--space-page-bottom);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-caption,
    .home-feed {
      animation: home-rise 700ms var(--ease-out) both;
    }

    .home-feed {
      animation-delay: 90ms;
    }
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 52rem) {
    .home {
      padding-block: 3rem 5.25rem;
    }
  }
</style>
