---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../lib/posts";
import { getPublishedShuoshuo } from "../lib/shuoshuo";
import { blogSettings } from "../lib/site";
import "../styles/shuoshuo-card.css";

const [{ posts: publishedPosts }, publishedShuoshuo] = await Promise.all([
  getPublishedPostCatalog(),
  getPublishedShuoshuo(),
]);
const recentPosts = publishedPosts.slice(0, 5);
const recentShuoshuo = publishedShuoshuo.slice(0, 3);
const { headline } = blogSettings.home;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout>
  <div class="mx-auto w-full max-w-[62rem] pt-[clamp(4.5rem,9vw,7rem)] pb-[clamp(5rem,9vw,7.5rem)]">
    <!-- 开场：标题句承载作者声音，取代占位主视觉（ADR-0020） -->
    <header class="max-w-[42rem]">
      <h1
        id="home-title"
        class="home-caption font-serif text-[clamp(2.1rem,3.4vw,2.75rem)] leading-[1.18] font-semibold tracking-[-0.02em] text-text"
      >
        {headline.text}
      </h1>
      <p class="mt-5 max-w-[36rem] font-serif text-[1.08rem] leading-[1.7] text-muted">
        {blogSettings.site.description}
      </p>
    </header>

    <div
      class="mt-[clamp(3rem,6vw,4.5rem)] grid gap-x-[clamp(2rem,4vw,3.5rem)] gap-y-12 min-[52rem]:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)]"
    >
      <section class="border-t border-text pt-4" aria-labelledby="recent-posts">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="recent-posts" class="text-[1rem] font-semibold tracking-[-0.02em]">最近文章</h2>
          <a
            class="text-[0.86rem] whitespace-nowrap text-muted no-underline hover:text-text"
            href="/archives/"
          >
            查看全部 ({postCount})
          </a>
        </div>
        {
          recentPosts.length > 0 ? (
            <ol class="divide-y divide-line">
              {recentPosts.map(post => (
                <li class="grid grid-cols-[5.25rem_minmax(0,1fr)] items-baseline gap-x-4 py-3">
                  <time datetime={post.publishedAt.iso} class="font-mono text-[0.78rem] text-muted">
                    {post.publishedAt.compact}
                  </time>
                  <a
                    class="font-serif text-[1.02rem] leading-[1.45] font-semibold wrap-anywhere text-text no-underline hover:text-accent"
                    href={post.href}
                  >
                    {post.title}
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="border-t border-text pt-4" aria-labelledby="recent-shuoshuo">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="recent-shuoshuo" class="text-[1rem] font-semibold tracking-[-0.02em]">
            最近说说
          </h2>
          <a
            class="text-[0.86rem] whitespace-nowrap text-muted no-underline hover:text-text"
            href="/shuoshuo/"
          >
            查看全部 ({shuoshuoCount})
          </a>
        </div>
        {
          recentShuoshuo.length > 0 ? (
            <div class="grid gap-3">
              {recentShuoshuo.map(item => (
                <article class="shuoshuo-preview" aria-label={item.label}>
                  <time datetime={item.publishedAt.iso} class="font-mono text-[0.78rem] text-muted">
                    {item.publishedAt.compact}
                  </time>
                  <a
                    class="mt-1.5 block font-serif text-[0.98rem] leading-[1.55] wrap-anywhere text-text no-underline hover:text-accent"
                    href={item.href}
                  >
                    {item.summary}
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>
