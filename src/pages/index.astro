---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../lib/posts";
import {
  formatShuoshuoDateCompact,
  getPublishedShuoshuo,
  getShuoshuoLabel,
  getShuoshuoPreviewLine,
} from "../lib/shuoshuo";
import { siteConfig } from "../lib/site";

const [{ posts: publishedPosts }, publishedShuoshuo] = await Promise.all([
  getPublishedPostCatalog(),
  getPublishedShuoshuo(),
]);
const [latestPost] = publishedPosts;
const [latestShuoshuo] = publishedShuoshuo;
const shuoshuoPreviewLine = latestShuoshuo ? getShuoshuoPreviewLine(latestShuoshuo.body ?? "") : "";
const { hero } = siteConfig;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <h1 id="home-title" class="hero-caption">{hero.caption}</h1>

    <section class="hero-media" aria-label={hero.alt}>
      <img
        class="hero-image hero-image-light"
        src={hero.src}
        width={hero.width}
        height={hero.height}
        alt={hero.alt}
        decoding="async"
        fetchpriority="high"
      />
      <img
        class="hero-image hero-image-dark"
        src={hero.srcDark}
        width={hero.width}
        height={hero.height}
        alt={hero.alt}
        decoding="async"
      />
    </section>

    <div class="home-feed">
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          <a href="/archives/">查看全部 ({postCount})</a>
        </div>
        {
          latestPost ? (
            <article class="post-preview">
              <time datetime={latestPost.publishedAt.iso}>{latestPost.publishedAt.compact}</time>
              <h3>
                <a href={latestPost.href}>{latestPost.title}</a>
              </h3>
              <p class="post-preview-description">{latestPost.description}</p>
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="feed-section" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          <a href="/shuoshuo/">查看全部 ({shuoshuoCount})</a>
        </div>
        {
          latestShuoshuo && shuoshuoPreviewLine ? (
            <article
              class="post-preview shuoshuo-preview"
              aria-label={getShuoshuoLabel(latestShuoshuo.data.publishedAt)}
            >
              <time datetime={latestShuoshuo.data.publishedAt.toISOString()}>
                {formatShuoshuoDateCompact(latestShuoshuo.data.publishedAt)}
              </time>
              <h3>
                <a href={`/shuoshuo/#${latestShuoshuo.id}`}>{shuoshuoPreviewLine}</a>
              </h3>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>
