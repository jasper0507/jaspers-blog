---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../lib/posts";
import { getPublishedShuoshuo } from "../lib/shuoshuo";
import { blogSettings } from "../lib/site";
import "../styles/shuoshuo-card.css";

const [{ posts: publishedPosts }, publishedShuoshuo] = await Promise.all([
  getPublishedPostCatalog(),
  getPublishedShuoshuo(),
]);
const [latestPost] = publishedPosts;
const [latestShuoshuo] = publishedShuoshuo;
const { hero } = blogSettings.home;
const hasDarkHero = hero.darkImage !== hero.lightImage;
const postCount = publishedPosts.length;
const shuoshuoCount = publishedShuoshuo.length;
---

<BaseLayout pageClass="home">
  <div class="home-grid">
    <h1 id="home-title" class="hero-caption">{hero.caption}</h1>

    <div class="hero-media">
      <img
        class:list={["hero-image", hasDarkHero && "hero-image-light"]}
        src={hero.lightImage}
        width="1248"
        height="832"
        alt={hero.alt}
        decoding="async"
        fetchpriority="high"
      />
      {
        hasDarkHero && (
          <img
            class="hero-image hero-image-dark"
            src={hero.darkImage}
            width="1248"
            height="832"
            alt={hero.alt}
            decoding="async"
          />
        )
      }
    </div>

    <div class="home-feed">
      <section class="feed-section" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最近文章</h2>
          <a href="/archives/">查看全部 ({postCount})</a>
        </div>
        {
          latestPost ? (
            <article class="post-preview">
              <time datetime={latestPost.publishedAt.iso}>{latestPost.publishedAt.compact}</time>
              <h3>
                <a href={latestPost.href}>{latestPost.title}</a>
              </h3>
              <p class="post-preview-description">{latestPost.description}</p>
            </article>
          ) : (
            <p class="empty-state">技术文章尚未发布。</p>
          )
        }
      </section>

      <section class="feed-section" aria-labelledby="recent-shuoshuo">
        <div class="section-heading">
          <h2 id="recent-shuoshuo">最近说说</h2>
          <a href="/shuoshuo/">查看全部 ({shuoshuoCount})</a>
        </div>
        {
          latestShuoshuo ? (
            <article class="post-preview shuoshuo-preview" aria-label={latestShuoshuo.label}>
              <time datetime={latestShuoshuo.publishedAt.iso}>
                {latestShuoshuo.publishedAt.compact}
              </time>
              <h3>
                <a href={latestShuoshuo.href}>{latestShuoshuo.summary}</a>
              </h3>
            </article>
          ) : (
            <p class="empty-state">暂无说说</p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * 双行两栏：行1 caption | 空；行2 图 | 信息流
   * 使 feed 顶与图顶对齐
   */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(2.5rem, 4vw, 4.5rem);
    row-gap: 1.45rem;
    align-items: start;
  }

  .hero-caption {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.45rem);
    font-weight: 600;
    letter-spacing: var(--track-display);
    line-height: var(--leading-display);
    font-optical-sizing: auto;
  }

  .hero-media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    min-width: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.65rem;
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    pointer-events: none;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* 亮/暗双图：跟随 data-theme 与系统偏好 */
  .hero-image-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .hero-image-light {
    display: none;
  }

  :global(html[data-theme="dark"]) .hero-image-dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .hero-image-light {
      display: none;
    }

    :global(html:not([data-theme="light"])) .hero-image-dark {
      display: block;
    }
  }

  .home-feed {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    gap: 3.25rem;
    min-width: 0;
  }

  /* 分区线：信息流栏近满宽细线 */
  .feed-section {
    padding-top: 1.25rem;
    border-top: 1px solid var(--text);
  }

  .section-heading {
    margin-bottom: 1.25rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .section-heading a {
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none;
  }

  .section-heading a:hover {
    color: var(--text);
  }

  .section-heading a:active,
  .post-preview h3 a:active {
    transform: translateY(1px);
  }

  .post-preview {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .post-preview h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.42;
    overflow-wrap: anywhere;
    font-optical-sizing: auto;
  }

  .post-preview h3 a {
    text-decoration: none;
  }

  .post-preview p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  /* 首页最近文章：两行预览 */
  .post-preview-description {
    margin: 0;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    line-height: 1.65;
  }

  .post-preview time,
  .shuoshuo-preview time {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  @media (max-width: 52rem) {
    .home-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      column-gap: 0;
      row-gap: 2.75rem;
    }

    .hero-caption,
    .hero-media,
    .home-feed {
      grid-column: 1;
      grid-row: auto;
    }

    .hero-media {
      max-width: 28rem;
    }
  }

  @media (max-width: 30rem) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<style is:global>
  .home {
    padding-block: var(--space-page-top) var(--space-page-bottom);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-caption,
    .home-feed {
      animation: home-rise 700ms var(--ease-out) both;
    }

    .home-feed {
      animation-delay: 90ms;
    }
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 52rem) {
    .home {
      padding-block: 3rem 5.25rem;
    }
  }
</style>
