---
import MarkdownBody from "../../components/MarkdownBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogSettings } from "../../lib/site";
import { getPublishedShuoshuo } from "../../lib/shuoshuo";
import "../../styles/shuoshuo-card.css";

const shuoshuo = await Promise.all(
  (await getPublishedShuoshuo()).map(async item => ({
    item,
    Content: (await item.render()).Content,
  })),
);
---

<BaseLayout
  title="说说"
  description={`${blogSettings.author.name} 发布的轻量文字与照片内容。`}
  pageClass="page-shell"
>
  <h1 id="shuoshuo-title" class="sr-only">说说</h1>
  {
    shuoshuo.length > 0 ? (
      <ol class="shuoshuo-list">
        {shuoshuo.map(({ item, Content }) => {
          const bodyId = `shuoshuo-body-${item.id}`;

          return (
            <li>
              <article class="shuoshuo-card" aria-label={item.label}>
                <h2 class="sr-only" id={item.id}>
                  {item.label}
                </h2>
                <a class="shuoshuo-anchor" href={item.href} aria-label={item.permalinkLabel}>
                  <time datetime={item.publishedAt.iso}>{item.publishedAt.long}</time>
                </a>
                <div class="shuoshuo-body" id={bodyId}>
                  <MarkdownBody>
                    <Content />
                  </MarkdownBody>
                </div>
                <button
                  class="shuoshuo-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls={bodyId}
                  data-shuoshuo-toggle={item.id}
                  hidden
                >
                  展开
                </button>
              </article>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="empty-state">暂无说说</p>
    )
  }
</BaseLayout>

<script is:inline>
  document.querySelectorAll("[data-shuoshuo-toggle]").forEach(button => {
    if (!(button instanceof HTMLButtonElement)) return;
    const id = button.dataset.shuoshuoToggle;
    const body = id && document.querySelector(`#shuoshuo-body-${id}`);
    if (!(body instanceof HTMLDivElement)) return;

    body.toggleAttribute("data-collapsed", true);
    if (body.scrollHeight <= body.clientHeight) {
      body.removeAttribute("data-collapsed");
      return;
    }
    body.inert = true;
    button.hidden = false;
    button.addEventListener("click", () => {
      const expanded = !body.toggleAttribute("data-collapsed");
      body.inert = !expanded;
      button.setAttribute("aria-expanded", String(expanded));
      button.textContent = expanded ? "收起" : "展开";
    });
  });
</script>

<style>
  .shuoshuo-body {
    overflow: hidden;
  }

  .shuoshuo-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.15rem;
  }

  .shuoshuo-list > li {
    min-width: 0;
    scroll-margin-top: 1.5rem;
  }

  .shuoshuo-list > li:has(h2:target) .shuoshuo-card {
    border-color: var(--accent);
  }

  .shuoshuo-list h2 {
    scroll-margin-top: 1.5rem;
  }

  .shuoshuo-anchor {
    display: inline-block;
    margin-bottom: 0.9rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  .shuoshuo-body[data-collapsed] {
    max-height: 12rem;
    mask-image: linear-gradient(to bottom, #000 75%, transparent);
  }

  .shuoshuo-toggle {
    margin-top: 0.85rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
  }
</style>

<style is:global>
  .shuoshuo-body .post-body {
    font-size: 1.0625rem;
  }
</style>
