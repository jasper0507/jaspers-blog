---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="没有找到这个页面"
  description="这个地址没有对应的内容。"
  pageClass="page-shell not-found"
>
  <h1>没有找到这个页面</h1>
  <p>这个地址没有对应的内容。可以从首页或归档继续读。</p>
  <p class="not-found-links">
    <a href="/">回首页</a>
    <a href="/archives/">归档</a>
  </p>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 1.15rem;
    font-family: var(--font-serif);
    font-size: clamp(1.95rem, 4.2vw, 2.7rem);
    font-weight: 600;
    letter-spacing: var(--track-display);
    line-height: var(--leading-display);
    font-optical-sizing: auto;
  }

  p {
    max-width: 34rem;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem;
    margin-top: 2rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .not-found-links a {
    color: var(--text);
  }
</style>
