---
import { getEntry, render } from "astro:content";
import MarkdownBody from "../components/MarkdownBody.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogSettings } from "../lib/site";

const about = await getEntry("about", "about");
if (!about) throw new Error("缺少关于我正文");
const { Content } = await render(about);

const description = `关于 ${blogSettings.author.name} 与 ${blogSettings.site.title}。`;
---

<BaseLayout title="关于" description={description} pageClass="page-shell about-page">
  <h1 class="sr-only">关于</h1>
  <MarkdownBody>
    <Content />
  </MarkdownBody>
</BaseLayout>

<style>
  /* 未提供新的 Markdown h1 尺度，保留关于页原有标题排版。 */
  :global(.about-page .post-body h1) {
    margin: 0 0 1.5rem;
    color: var(--body-heading);
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: var(--track-display);
    line-height: 1.12;
    font-optical-sizing: auto;
  }

  :global(.about-page .post-body) {
    max-width: 38rem;
  }
</style>
