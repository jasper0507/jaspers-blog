---
import { Content } from "../content/about.md";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogSettings } from "../lib/site";

const description = `关于 ${blogSettings.author.name} 与 ${blogSettings.site.title}。`;
---

<BaseLayout title="关于" description={description} pageClass="prose">
  <h1 class="sr-only">关于</h1>
  <Content />
</BaseLayout>

<style>
  :global(.prose) {
    max-width: 48rem;
    padding-top: clamp(4rem, 8vw, 6.5rem);
    padding-bottom: clamp(5rem, 9vw, 7.5rem);
  }

  :global(.prose h1) {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  :global(.prose p),
  :global(.prose li) {
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
  }

  :global(.prose strong),
  :global(.prose b) {
    font-weight: 700;
  }

  :global(.prose p),
  :global(.prose ul) {
    max-width: 42rem;
  }

  :global(.prose p) {
    margin-block: 0 1.25rem;
  }

  :global(.prose ul) {
    padding-left: 1.25rem;
  }
</style>
