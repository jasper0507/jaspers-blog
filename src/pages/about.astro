---
import { Content } from "../content/about.md";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogSettings } from "../lib/site";

const description = `关于 ${blogSettings.author.name} 与 ${blogSettings.site.title}。`;
---

<BaseLayout title="关于" description={description} pageClass="page-shell about-page">
  <h1 class="sr-only">关于</h1>
  <Content />
</BaseLayout>

<style>
  :global(.about-page h1) {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  :global(.about-page p),
  :global(.about-page li) {
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
  }

  :global(.about-page strong),
  :global(.about-page b) {
    font-weight: 700;
  }

  :global(.about-page p),
  :global(.about-page ul) {
    max-width: 42rem;
  }

  :global(.about-page p) {
    margin-block: 0 1.25rem;
  }

  :global(.about-page ul) {
    padding-left: 1.25rem;
    /* Tailwind preflight 抹掉浏览器默认列表记号，这里显式恢复 */
    list-style: disc;
  }
</style>
