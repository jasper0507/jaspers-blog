---
import { getEntry, render } from "astro:content";
import MarkdownBody from "../components/MarkdownBody.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogSettings } from "../lib/site";

const about = await getEntry("about", "about");
if (!about) throw new Error("缺少关于我正文");
const { Content } = await render(about);

const description = `关于 ${blogSettings.author.name} 与 ${blogSettings.site.title}。`;
---

<BaseLayout title="关于" description={description} pageClass="page-shell about-page">
  <h1 class="sr-only">关于</h1>
  <MarkdownBody>
    <Content />
  </MarkdownBody>
</BaseLayout>

<style>
  /* 未提供新的 Markdown h1 尺度，保留关于页原有标题排版。 */
  :global(.about-page .post-body h1) {
    margin: 0 0 1.5rem;
    color: var(--body-heading);
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: var(--track-display);
    line-height: 1.12;
    font-optical-sizing: auto;
  }

  /* 关于页在字体更新前不使用公共正文间距；只恢复 margin / padding。 */
  :global(
    .about-page
      .post-body
      :is(
        h2,
        h3,
        h4,
        h5,
        h6,
        p,
        ul,
        ol,
        li,
        blockquote,
        img,
        pre,
        table,
        th,
        td,
        hr,
        details,
        summary,
        code,
        mark
      )
  ) {
    margin: 0;
    padding: 0;
  }

  :global(.about-page .post-body input[type="checkbox"]),
  :global(.about-page .post-body details[open] summary),
  :global(.about-page .post-body .katex-display),
  :global(.about-page .post-body .astro-code[data-title]::before) {
    margin: 0;
    padding: 0;
  }

  :global(.about-page .post-body p) {
    margin-bottom: 1.4rem;
  }

  :global(.about-page .post-body p:first-of-type) {
    margin-bottom: 1.85rem;
  }

  :global(.about-page .post-body ul) {
    padding-left: 1.35rem;
  }

  :global(.about-page .post-body) {
    max-width: 38rem;
  }
</style>
