---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="关于" description="关于 Jasper 与 Jasper's Blog。" pageClass="prose">
  <h1 class="sr-only">关于</h1>

  <p>我是 Jasper。</p>

  <p>这里是我的个人网站，以技术文章为核心，也用说说记录轻量的想法。</p>

  <ul>
    <li><a href="https://github.com/jasper0507">GitHub</a></li>
    <li><a href="mailto:jasper0507.self@gmail.com">公开邮箱</a></li>
  </ul>
</BaseLayout>

<style>
  :global(.prose) {
    max-width: 48rem;
    padding-top: clamp(4rem, 8vw, 6.5rem);
    padding-bottom: clamp(5rem, 9vw, 7.5rem);
  }

  h1 {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  p,
  li {
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
  }

  strong,
  b {
    font-weight: 700;
  }

  p,
  ul {
    max-width: 42rem;
  }

  p {
    margin-block: 0 1.25rem;
  }

  ul {
    padding-left: 1.25rem;
  }
</style>
