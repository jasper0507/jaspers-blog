---
import PostReading from "../../components/PostReading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogSettings } from "../../lib/site";
import { getPublishedPostCatalog, type PublishedPost } from "../../lib/posts";

interface Props {
  post: PublishedPost;
}

export async function getStaticPaths() {
  return (await getPublishedPostCatalog()).posts.map(post => ({
    params: { id: String(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const postUrl = new URL(post.href, blogSettings.site.url);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description.trim() || blogSettings.site.description,
  url: postUrl.href,
  mainEntityOfPage: postUrl.href,
  datePublished: post.publishedAt.iso,
  inLanguage: "zh-CN",
  author: { "@type": "Person", name: blogSettings.author.name },
}).replaceAll("<", "\\u003c");
---

<BaseLayout
  title={post.title}
  description={post.description}
  pageClass="post-page"
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={structuredData} is:inline />

  <PostReading post={post} headings={headings}>
    <Content />
  </PostReading>
</BaseLayout>

<style is:global>
  .post-page {
    max-width: var(--shell-width);
    padding: var(--space-page-top) 0 var(--space-page-bottom);
  }

  @media (max-width: 70rem) {
    .post-page {
      padding-inline: var(--gutter);
    }
  }
</style>
