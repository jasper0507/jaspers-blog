---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDate, getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout
  title="文章"
  description="Jasper 发布的技术文章。"
  pageClass="page-shell"
>
  <section class="page-intro" aria-labelledby="posts-title">
    <h1 id="posts-title">文章</h1>
    <p>技术实践、学习笔记与论文精读。</p>
  </section>
  <ol class="post-list">
    {
      posts.map(post => (
        <li>
          <article class="post-preview">
            <h2>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatPostDate(post.data.publishedAt)}
            </time>
            <ul class="post-tags" aria-label="标签">
              {post.data.tags.map(tag => <li>{tag}</li>)}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</BaseLayout>
