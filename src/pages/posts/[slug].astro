---
import MarkdownBody from "../../components/MarkdownBody.astro";
import PostTags from "../../components/PostTags.astro";
import PostToc from "../../components/PostToc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPostCatalog, type PublishedPost } from "../../lib/posts";

interface Props {
  post: PublishedPost;
}

export async function getStaticPaths() {
  return (await getPublishedPostCatalog()).posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const postUrl = new URL(post.href, Astro.site);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  url: postUrl.href,
  mainEntityOfPage: postUrl.href,
  datePublished: post.publishedAt.iso,
  dateModified: post.modifiedAtIso,
  inLanguage: "zh-CN",
  author: { "@type": "Person", name: "Jasper" },
}).replaceAll("<", "\\u003c");
---

<BaseLayout
  title={post.title}
  description={post.description}
  pageClass="post-page"
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={structuredData} is:inline />

  <article class="post-article" aria-labelledby="post-title" data-pagefind-body>
    <header class="post-header">
      <h1 id="post-title">{post.title}</h1>
      <p class="post-description">{post.description}</p>
      <div class="post-meta">
        <time datetime={post.publishedAt.iso}>{post.publishedAt.compact}</time>
        <PostTags tags={post.tags} />
      </div>
    </header>

    <MarkdownBody>
      <Content />
    </MarkdownBody>
  </article>

  <PostToc headings={headings} />
</BaseLayout>

<style>
  /* 编辑长文壳：居中阅读栏，无纸面卡片 */
  .post-article {
    max-width: var(--reading-width);
    margin-inline: auto;
    min-width: 0;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .post-header h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .post-description {
    max-width: 42rem;
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin-top: 1.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  @media (max-width: 52rem) {
    .post-header {
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
    }

    .post-header h1 {
      font-size: 1.875rem;
    }

    .post-meta {
      margin-top: 1.35rem;
    }
  }
</style>

<style is:global>
  .post-page {
    /* 编辑长文阅读栏（JacksBlog --reading ≈ 760px）；PostToc 继承使用。 */
    --reading-width: 47.5rem;
    max-width: var(--shell-width);
    padding: clamp(4rem, 8vw, 6.5rem) 0 clamp(5rem, 9vw, 7.5rem);
  }

  .post-meta .post-tags {
    justify-content: flex-end;
    margin-inline-start: auto;
  }

  @media (max-width: 70rem) {
    .post-page {
      padding-inline: var(--gutter);
    }
  }
</style>
