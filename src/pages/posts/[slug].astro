---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import "katex/dist/katex.min.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDate, getPublishedPosts } from "../../lib/posts";
import { getTagSlug } from "../../lib/tags";

interface Props {
  post: CollectionEntry<"posts">;
}

export async function getStaticPaths() {
  return (await getPublishedPosts()).map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(
  ({ depth, slug }) =>
    (depth === 2 || depth === 3) && slug !== "footnote-label",
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  pageClass="post-page"
>
  <article class="post-article" aria-labelledby="post-title">
    <header class="post-header">
      <h1 id="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-meta">
        <time datetime={post.data.publishedAt.toISOString()}>
          发布于 {formatPostDate(post.data.publishedAt)}
        </time>
        {
          post.data.updatedAt && (
            <time datetime={post.data.updatedAt.toISOString()}>
              更新于 {formatPostDate(post.data.updatedAt)}
            </time>
          )
        }
      </div>
      <ul class="post-tags" aria-label="标签">
        {
          post.data.tags.map(tag => (
            <li><a href={`/tags/${getTagSlug(tag)}/`}>{tag}</a></li>
          ))
        }
      </ul>
    </header>

    <div class="post-body">
      <Content />
    </div>

    <nav class="post-toc" aria-label="文章目录">
      <p>目录</p>
      <ol>
        {
          toc.map(heading => (
            <li class:list={[`toc-depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))
        }
      </ol>
    </nav>
  </article>
</BaseLayout>
