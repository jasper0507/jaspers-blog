---
import MarkdownBody from "../../components/MarkdownBody.astro";
import PostTags from "../../components/PostTags.astro";
import PostToc from "../../components/PostToc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPostCatalog, type PublishedPost } from "../../lib/posts";

interface Props {
  post: PublishedPost;
}

export async function getStaticPaths() {
  return (await getPublishedPostCatalog()).posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const postUrl = new URL(post.href, Astro.site);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  url: postUrl.href,
  mainEntityOfPage: postUrl.href,
  datePublished: post.publishedAt.iso,
  dateModified: post.modifiedAtIso,
  inLanguage: "zh-CN",
  author: { "@type": "Person", name: "Jasper" },
}).replaceAll("<", "\\u003c");
---

<BaseLayout
  title={post.title}
  description={post.description}
  pageClass="post-page"
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={structuredData} is:inline />

  <article class="post-article" aria-labelledby="post-title" data-pagefind-body>
    <header class="post-header">
      <h1 id="post-title">{post.title}</h1>
      <p class="post-description">{post.description}</p>
      <div class="post-meta">
        <time datetime={post.publishedAt.iso}>{post.publishedAt.compact}</time>
        <PostTags tags={post.tags} />
      </div>
    </header>

    <MarkdownBody>
      <Content />
    </MarkdownBody>
  </article>

  <PostToc headings={headings} />
</BaseLayout>
