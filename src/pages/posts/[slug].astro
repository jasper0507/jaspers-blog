---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import "katex/dist/katex.min.css";
import PostTags from "../../components/PostTags.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDateCompact, getPublishedPosts } from "../../lib/posts";

interface Props {
  post: CollectionEntry<"posts">;
}

export async function getStaticPaths() {
  return (await getPublishedPosts()).map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const postUrl = new URL(`/posts/${post.id}/`, Astro.site);
const toc = headings.filter(
  ({ depth, slug }) => (depth === 2 || depth === 3) && slug !== "footnote-label",
);
const publishedLabel = formatPostDateCompact(post.data.publishedAt);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  pageClass="post-page"
  ogType="article"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: postUrl.href,
    mainEntityOfPage: postUrl.href,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    inLanguage: "zh-CN",
    author: { "@type": "Person", name: "Jasper" },
  }}
>
  <article class="post-article" aria-labelledby="post-title" data-pagefind-body>
    <header class="post-header">
      <h1 id="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{publishedLabel}</time>
        <PostTags tags={post.data.tags} />
      </div>
    </header>

    <div class="post-body">
      <Content />
    </div>
  </article>

  {
    toc.length > 0 && (
      <nav class="post-toc" aria-label="文章目录">
        <p>目录</p>
        <ol>
          {toc.map(heading => (
            <li class:list={[`toc-depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <script is:inline>
    (() => {
      const tocNav = document.querySelector(".post-toc");
      if (!(tocNav instanceof HTMLElement)) return;

      const items = [...tocNav.querySelectorAll('a[href^="#"]')]
        .map(link => {
          if (!(link instanceof HTMLAnchorElement)) return null;
          const id = decodeURIComponent(link.getAttribute("href")?.slice(1) ?? "");
          const heading = id ? document.getElementById(id) : null;
          return heading ? { link, heading } : null;
        })
        .filter(Boolean);

      if (!items.length) return;

      let activeId = "";
      const setActive = id => {
        if (!id || id === activeId) return;
        activeId = id;
        for (const { link, heading } of items) {
          if (heading.id === id) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      };

      // 初始：靠近视口顶部的第一节
      setActive(items[0].heading.id);

      if (!("IntersectionObserver" in window)) return;

      const visible = new Map();
      const observer = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.set(entry.target.id, entry);
            else visible.delete(entry.target.id);
          }
          if (!visible.size) return;
          const topmost = [...visible.values()].sort(
            (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
          )[0];
          if (topmost?.target?.id) setActive(topmost.target.id);
        },
        {
          // 上半屏进入即视为当前节（成熟 TOC scroll-spy 惯例）
          rootMargin: "0px 0px -55% 0px",
          threshold: [0, 0.25, 1],
        },
      );

      for (const { heading } of items) observer.observe(heading);
    })();
  </script>
</BaseLayout>
