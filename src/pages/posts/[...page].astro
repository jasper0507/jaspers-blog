---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, POSTS_PER_PAGE } from "../../lib/posts";

interface Props {
  page: Page<CollectionEntry<"posts">>;
}

export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getPublishedPosts(), {
    pageSize: POSTS_PER_PAGE,
  })) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage === 1 ? "文章" : `文章 - 第 ${page.currentPage} 页`}
  description="Jasper 发布的技术文章。"
  pageClass="page-shell"
>
  <section class="page-intro" aria-labelledby="posts-title">
    <h1 id="posts-title">文章</h1>
    <p>技术实践、学习笔记与论文精读。</p>
  </section>
  <PostList posts={page.data} />
  <nav class="pagination" aria-label="文章分页">
    {page.url.prev && <a href={page.url.prev} rel="prev">上一页</a>}
    <span aria-current="page">第 {page.currentPage} / {page.lastPage} 页</span>
    {page.url.next && <a href={page.url.next} rel="next">下一页</a>}
  </nav>
</BaseLayout>
