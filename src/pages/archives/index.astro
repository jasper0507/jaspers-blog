---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostTags from "../../components/PostTags.astro";
import { formatPostDateIso, getPostYear, getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
const years = [...new Set(posts.map(post => getPostYear(post.data.publishedAt)))];
---

<BaseLayout
  title="归档"
  description="按时间浏览 Jasper 的技术文章。"
  pageClass="page-shell archive-page"
>
  <h1 id="archives-title" class="sr-only">归档</h1>
  {
    years.map(year => (
      <section class="archive-year" aria-labelledby={`archive-${year}`}>
        <h2 id={`archive-${year}`}>{year} 年</h2>
        <ol class="archive-timeline">
          {posts
            .filter(post => getPostYear(post.data.publishedAt) === year)
            .map(post => (
              <li>
                <article class="archive-card">
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatPostDateIso(post.data.publishedAt)}
                  </time>
                  <a class="archive-card-title" href={`/posts/${post.id}/`}>
                    {post.data.title}
                  </a>
                  <PostTags tags={post.data.tags} />
                </article>
              </li>
            ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>
