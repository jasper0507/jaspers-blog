---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostTags from "../../components/PostTags.astro";
import { getPublishedPostCatalog } from "../../lib/posts";
import { blogSettings } from "../../lib/site";

const { archive } = await getPublishedPostCatalog();
---

<BaseLayout
  title="归档"
  description={`按时间浏览 ${blogSettings.author.name} 的技术文章。`}
  pageClass="page-shell archive-page"
>
  <h1 id="archives-title" class="sr-only">归档</h1>
  {
    archive.length > 0 ? (
      archive.map(({ year, posts }) => (
        <section class="archive-year" aria-labelledby={`archive-${year}`}>
          <h2 id={`archive-${year}`}>{year} 年</h2>
          <ol class="archive-timeline">
            {posts.map(post => (
              <li>
                <article class="archive-card">
                  <time datetime={post.publishedAt.iso}>{post.publishedAt.date}</time>
                  <a class="archive-card-title" href={post.href}>
                    {post.title}
                  </a>
                  <PostTags tags={post.tags} />
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))
    ) : (
      <p class="empty-state">暂无技术文章</p>
    )
  }
</BaseLayout>

<style>
  .archive-year {
    margin-top: 2.75rem;
  }

  .archive-year:first-of-type {
    margin-top: 0;
  }

  .archive-year > h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .archive-timeline {
    /* 轴线中心与圆点中心共用同一横坐标，避免 border-left + 手工偏移错位 */
    --archive-rail-x: 0.5rem;
    --archive-dot-size: 0.55rem;
    --archive-content-inset: 1.65rem;
    position: relative;
    margin: 1.25rem 0 0;
    padding: 0 0 0 var(--archive-content-inset);
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .archive-timeline::before {
    content: "";
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: var(--archive-rail-x);
    width: 1px;
    background: var(--line);
    transform: translateX(-50%);
  }

  .archive-timeline > li {
    position: relative;
    min-width: 0;
  }

  .archive-timeline > li::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: 1.7rem;
    left: calc(var(--archive-rail-x) - var(--archive-content-inset));
    width: var(--archive-dot-size);
    height: var(--archive-dot-size);
    border: 2px solid var(--background);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--line);
    transform: translate(-50%, -50%);
  }

  .archive-card {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
    transition:
      border-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .archive-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: var(--shadow-float);
    transform: translateY(-1px);
  }

  .archive-card:active {
    transform: translateY(0);
  }

  .archive-card time {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-meta);
  }

  .archive-card-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.42;
    overflow-wrap: anywhere;
    text-decoration: none;
    font-optical-sizing: auto;
  }

  .archive-card-title:hover {
    color: var(--accent);
  }
</style>

<style is:global>
  .archive-card .post-tags {
    margin: 0.15rem 0 0;
    justify-content: flex-start;
    margin-inline-start: 0;
  }
</style>
