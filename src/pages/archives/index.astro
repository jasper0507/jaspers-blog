---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostTags from "../../components/PostTags.astro";
import { getPublishedPostCatalog } from "../../lib/posts";

const { archive } = await getPublishedPostCatalog();
---

<BaseLayout
  title="归档"
  description="按时间浏览 Jasper 的技术文章。"
  pageClass="page-shell archive-page"
>
  <h1 id="archives-title" class="sr-only">归档</h1>
  {
    archive.map(({ year, posts }) => (
      <section class="archive-year" aria-labelledby={`archive-${year}`}>
        <h2 id={`archive-${year}`}>{year} 年</h2>
        <ol class="archive-timeline">
          {posts.map(post => (
            <li>
              <article class="archive-card">
                <time datetime={post.publishedAt.iso}>{post.publishedAt.date}</time>
                <a class="archive-card-title" href={post.href}>
                  {post.title}
                </a>
                <PostTags tags={post.tags} />
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>

<style is:global>
  .archive-card .post-tags {
    margin: 0.15rem 0 0;
    justify-content: flex-start;
    margin-inline-start: 0;
  }
</style>
