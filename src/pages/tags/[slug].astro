---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDateIso, getPublishedPosts } from "../../lib/posts";
import { getPublishedPostTags } from "../../lib/tags";

type PublishedPost = Awaited<ReturnType<typeof getPublishedPosts>>[number];
type PublishedTag = ReturnType<typeof getPublishedPostTags<PublishedPost>>[number];

interface Props {
  tag: PublishedTag;
}

export const getStaticPaths = (async () =>
  getPublishedPostTags(await getPublishedPosts()).map(tag => ({
    params: { slug: tag.slug },
    props: { tag },
  }))) satisfies GetStaticPaths;

const { tag } = Astro.props;
---

<BaseLayout
  title={`标签：${tag.name}`}
  description={`浏览标签“${tag.name}”下的技术文章。`}
  pageClass="page-shell"
>
  <h1 id="tag-title" class="sr-only">{tag.name}</h1>
  <ol class="tag-post-list">
    {
      tag.posts.map(post => (
        <li>
          <article class="tag-post-item">
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatPostDateIso(post.data.publishedAt)}
            </time>
            <a class="tag-post-title" href={`/posts/${post.id}/`}>
              {post.data.title}
            </a>
          </article>
        </li>
      ))
    }
  </ol>
</BaseLayout>
