---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../../lib/posts";

type PublishedTag = Awaited<ReturnType<typeof getPublishedPostCatalog>>["tags"][number];

interface Props {
  tag: PublishedTag;
}

export const getStaticPaths = (async () =>
  (await getPublishedPostCatalog()).tags.map(tag => ({
    params: { slug: tag.slug },
    props: { tag },
  }))) satisfies GetStaticPaths;

const { tag } = Astro.props;
---

<BaseLayout
  title={`标签：${tag.name}`}
  description={`浏览标签“${tag.name}”下的技术文章。`}
  pageClass="page-shell"
>
  <h1 id="tag-title" class="sr-only">{tag.name}</h1>
  <ol class="tag-post-list">
    {
      tag.posts.map(post => (
        <li>
          <article class="tag-post-item">
            <time datetime={post.publishedAt.iso}>{post.publishedAt.date}</time>
            <a class="tag-post-title" href={post.href}>
              {post.title}
            </a>
          </article>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  .tag-post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  .tag-post-list > li {
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .tag-post-list > li:last-child {
    border-bottom: 0;
  }

  .tag-post-item {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 0.85rem 1.1rem;
    align-items: baseline;
  }

  .tag-post-item time {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .tag-post-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .tag-post-title:hover {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .tag-post-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
