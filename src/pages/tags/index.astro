---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPostCatalog } from "../../lib/posts";
import { blogSettings } from "../../lib/site";

const { tags } = await getPublishedPostCatalog();
---

<BaseLayout
  title="标签"
  description={`按标签浏览 ${blogSettings.author.name} 的技术文章。`}
  pageClass="page-shell"
>
  <h1 id="tags-title" class="sr-only">标签</h1>
  {
    tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map(tag => (
          <li>
            <a href={tag.href}>
              {tag.name}
              <span class="tag-count">{tag.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">暂无标签</p>
    )
  }
</BaseLayout>

<style>
  .tag-cloud {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.7rem;
  }

  .tag-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--surface);
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.35;
    text-decoration: none;
    transform: scale(1);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease,
      color 0.15s ease;
  }

  .tag-cloud a:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: 0 0.3rem 0.85rem color-mix(in srgb, var(--text) 6%, transparent);
    color: var(--text);
    transform: scale(1.04);
  }

  .tag-cloud a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25em;
    padding: 0.05em 0.4em;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--line) 55%, var(--surface));
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78em;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
</style>
