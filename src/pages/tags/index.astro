---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPostTags } from "../../lib/posts";

const tags = await getPublishedPostTags();
---

<BaseLayout title="标签" description="按标签浏览 Jasper 的技术文章。" pageClass="page-shell">
  <h1 id="tags-title" class="sr-only">标签</h1>
  {
    tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map(tag => (
          <li>
            <a href={`/tags/${tag.slug}/`}>
              {tag.name}
              <span class="tag-count">{tag.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">暂无标签</p>
    )
  }
</BaseLayout>
